          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-950 py-2.5 px-4 text-center">
          <p class="text-[13px] font-bold text-[#BBF7D0]">
            Hamparan lahan cabai rawit sentra Jawa Timur panen nonstop cuan maksimal!
