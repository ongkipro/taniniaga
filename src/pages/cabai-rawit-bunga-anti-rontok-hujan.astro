            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[13px] font-bold leading-tight text-slate-900">Petikan Tiap 4 Hari</h3>
            <p class="mt-1 text-[12px] leading-snug text-slate-600">Produktivitas tinggi terus menerus</p>
