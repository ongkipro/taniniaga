---
/**
 * Native Landing Page: Panen Harga Selangit, Bunga Anti Rontok Dihajar Hujan - Saratoga (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/cabai-rawit-bunga-anti-rontok-hujan.css';

export const prerender = false;

const SLUG = 'cabai-rawit-bunga-anti-rontok-hujan';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/cabai-rawit-bunga-anti-rontok-hujan/hero-problem.webp';
---

<BaseLayout
  title={`Panen Harga Selangit, Bunga Anti Rontok Dihajar Hujan - Saratoga - ${Astro.locals.tenant.name}`}
  description="Panen cabai rawit melimpah saat harga pasar tembus Rp80.000-100.000/kg! Saratoga kunci tangkai bunga 10x lipat lebih kokoh, 98% sukses jadi buah lebat."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-4 text-center">
      <div class="px-5 pt-5">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.2] tracking-normal text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-normal text-[18px] font-extrabold uppercase">PANEN REKOR SAAT HARGA CABAI RAWIT TEMBUS RP80.000/KG!</span>
          Panen Harga Selangit! <span class="hl-brush">Bunga Anti Rontok Dihajar Hujan</span> Cabai Rawit Berbuah Lebat!
        </h1>
        <p class="mx-auto mt-3 max-w-[410px] text-[15px] font-normal leading-relaxed text-slate-700">
          Jangan biarkan bunga dan pentil cabai rawit rontok berserakan di bawah mulsa saat harga melonjak tinggi! SARATOGA memperkokoh tangkai bunga hingga 10x lipat, 98% bunga sukses jadi buah lebat sampai ke ujung ranting walau diguyur badai hujan malam!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Pohon cabai rawit berbuah lebat sampai ke pucuk ranting anti rontok bunga dihajar hujan"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2.5 text-center backdrop-blur-sm">
            <p class="text-[13px] font-bold text-[#BBF7D0]">
              Hasil Demplot Kediri & Temanggung: 98% bunga jadi buah, petik tiap 4 hari, tembus puluhan kuintal!
            </p>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 px-4 text-[13px] font-semibold text-slate-800">
          <span>Kunci Tangkai Bunga 10x Lipat</span>
          <span class="text-slate-300">•</span>
          <span>98% Jadi Buah Bernas</span>
          <span class="text-slate-300">•</span>
          <span>Petik Tiap 4 Hari</span>
          <span class="text-slate-300">•</span>
          <span>Bisa Bayar di Tempat (COD)</span>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.2] tracking-normal text-slate-950">
        2 Bencana Pengancam <span class="hl-brush-red">Bunga Cabai Rawit</span> di Musim Hujan
      </h2>
      <p class="text-[15px] text-slate-700 mt-2 mb-5 leading-relaxed">
        Saat harga cabai rawit lagi mahal-mahalnya, bunga dan pentil sering gugur massal karena hal ini:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src={`/images/landing/${SLUG}/gejala-1.webp`}
              alt="Bunga cabai rawit rontok berguguran di atas plastik mulsa hitam perak"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-1 text-[12px] font-bold text-white shadow">
              1. Gugur Bunga Massal
            </span>
          </div>
          <div class="p-4">
            <h3 class="text-[16px] font-bold text-slate-950">Bunga Menguning & Rontok Berserakan di Bawah Mulsa</h3>
            <p class="text-[13px] text-slate-600 mt-1.5 leading-relaxed">
              Tetesan hujan asam merusak lapisan absisi tangkai bunga, menyebabkan bunga lepas sebelum sempat terjadi penyerbukan sempurna.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src={`/images/landing/${SLUG}/gejala-2.webp`}
              alt="Pentil cabai rawit muda membusuk dan tangkainya mengering"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-1 text-[12px] font-bold text-white shadow">
              2. Pentil Hitam Membusuk
            </span>
          </div>
          <div class="p-4">
            <h3 class="text-[16px] font-bold text-slate-950">Pentil Buah Muda Menghitam & Rontok Sebelum Membesar</h3>
            <p class="text-[13px] text-slate-600 mt-1.5 leading-relaxed">
              Kekurangan boron dan kalsium aktif membuat tangkai pentil rapuh dan tidak sanggup menopang berat buah muda saat diterpa angin.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON (Full Visual Overclaim) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.2] tracking-normal text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Bunga Rontok</span> Jadi <span class="hl-brush">Buah Lebat Mengacung</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src={`/images/landing/${SLUG}/overclaim-timeline.webp`}
          alt="Progres pemulihan cabai rawit dari bunga rontok menjadi buah lebat bertingkat"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[12px] font-bold py-2.5 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 3: Tangkai Kaku Menghijau</span>
          <span class="text-amber-300">Hari 10: Pentil Menempel Kokoh</span>
          <span class="text-emerald-400">Hari 25: Buah Rapat Sampai Pucuk</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src={`/images/landing/${SLUG}/kondisi-rusak.webp`}
            alt="Cabai rawit tanpa Saratoga berbunga jarang dan rontok massal"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2.5 py-1 text-[12px] font-bold text-white shadow">
            Tanpa SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3.5">
            <h3 class="text-[14px] font-bold leading-tight text-slate-900">Ranting Gundul & Rontok</h3>
            <p class="mt-1 text-[13px] leading-snug text-slate-600">
              Bunga gugur berceceran di mulsa, buah jarang dan panen merugi.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src={`/images/landing/${SLUG}/kondisi-pulih.webp`}
            alt="Cabai rawit dengan Saratoga berbuah sangat lebat mengacung ke atas"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2.5 py-1 text-[12px] font-bold text-white shadow">
            Pakai SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3.5">
            <h3 class="text-[14px] font-bold leading-tight text-emerald-900">Buah Lebat Sampai Pucuk</h3>
            <p class="mt-1 text-[13px] leading-snug text-slate-700">
              Tangkai bunga super kokoh, 98% jadi buah lebat mengacung ke atas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer / Field Shot -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src={`/images/landing/${SLUG}/saratoga-hero.webp`}
          alt="Botol resmi Saratoga Serum Tanaman Premium berhologram asli di kebun"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge (Guaranteed local asset) -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-3 shadow-sm">
        <img
          src={`/images/landing/${SLUG}/product-packshot.webp`}
          alt="Foto Botol Resmi SARATOGA Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-white border border-emerald-100 p-1"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[13px] font-bold text-emerald-950">SARATOGA Original, Segel Hologram Resmi</p>
          <p class="text-[12px] text-slate-600 leading-snug mt-0.5">
            Serum Kalsium Boron Organik + Hormon Giberelin & Sitokinin Pengunci Bunga (Kemasan Resmi 250ml & 500ml).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.2] tracking-normal text-slate-950">
        3 Aksi Dahsyat <span class="hl-brush">Saratoga Pengunci Bunga Cabai</span>
      </h2>
      <p class="text-[15px] text-slate-700 mt-2 mb-5 leading-relaxed">
        Mengikat erat tangkai bunga ke dahan pohon sehingga tahan terpaan badai hujan ekstrem:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src={`/images/landing/${SLUG}/overclaim-1.webp`}
              alt="Tangkai bunga cabai rawit tebal kokoh hijau segar"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-4 pb-3 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2.5 py-1 text-[12px] font-bold text-white shadow">
                EFEK 1 • TANGKAI BUNGA SEKUAT BAJA
              </span>
              <h3 class="text-[16px] font-bold text-white mt-1.5 leading-snug">
                Hujan Badai Berhari-hari 0% Bunga Gugur Rontok!
              </h3>
            </div>
          </div>
          <p class="p-3.5 text-[14px] text-slate-700 leading-relaxed">
            Menghentikan pembentukan lapisan pemisah (absisi), membuat sambungan tangkai bunga melekat sekuat lem perekat alami.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src={`/images/landing/${SLUG}/overclaim-2.webp`}
              alt="Ketiak daun cabai rawit membawa dompolan pentil buah lebat"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-4 pb-3 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2.5 py-1 text-[12px] font-bold text-white shadow">
                EFEK 2 • LEDAKAN PENTIL BUAH 3D
              </span>
              <h3 class="text-[16px] font-bold text-white mt-1.5 leading-snug">
                Satu Ketiak Daun Membawa 4–6 Pentil Buah Sekaligus!
              </h3>
            </div>
          </div>
          <p class="p-3.5 text-[14px] text-slate-700 leading-relaxed">
            Memicu pembelahan titik tumbuh generatif serempak, ranting dipenuhi dompolan calon buah cabai rawit bertingkat-tingkat.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src={`/images/landing/${SLUG}/overclaim-3.webp`}
              alt="Buah cabai rawit merah segar dipetik penuh keranjang"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-4 pb-3 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2.5 py-1 text-[12px] font-bold text-white shadow">
                EFEK 3 • PETIK NONSTOP TIAP 4 HARI
              </span>
              <h3 class="text-[16px] font-bold text-white mt-1.5 leading-snug">
                Ranting Penuh Buah Tegak Mengacung, Petik Terus Nonstop!
              </h3>
            </div>
          </div>
          <p class="p-3.5 text-[14px] text-slate-700 leading-relaxed">
            Mempersingkat siklus pengisian buah, mempercepat pematangan merah serentak untuk memaksimalkan frekuensi petikan.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src={`/images/landing/${SLUG}/macro-proof.webp`}
          alt="Detail makro kuncup bunga dan pentil cabai rawit kokoh"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2.5 px-4 text-center">
          <p class="text-[13px] font-bold text-[#BBF7D0]">
            Tangkai Bunga Kokoh Menghijau: Serapan boron aktif mengunci putik bunga sempurna!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.2] tracking-normal text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis</span>
      </h2>

      <div class="-mx-5 my-4">
        <img
          src={`/images/landing/${SLUG}/aplikasi-kebun.webp`}
          alt="Aplikasi semprot kabut di lahan pertanian"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 items-stretch gap-2.5 text-center">
        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[12px] font-bold text-white">1</span>
          <h3 class="mt-2 text-[13px] font-bold leading-tight text-slate-900">Takaran</h3>
          <p class="mt-1 text-[12px] leading-snug text-slate-700">
            Gunakan 20–25 ml Saratoga per tangki 16 Liter.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[12px] font-bold text-white">2</span>
          <h3 class="mt-2 text-[13px] font-bold leading-tight text-slate-900">Aplikasi</h3>
          <p class="mt-1 text-[12px] leading-snug text-slate-700">
            Semprot kabut halus merata pada pucuk ranting dan kuncup bunga pagi hari.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[12px] font-bold text-white">3</span>
          <h3 class="mt-2 text-[13px] font-bold leading-tight text-slate-900">Interval</h3>
          <p class="mt-1 text-[12px] leading-snug text-slate-700">
            Mulai umur 40 HST saat kuncup pertama muncul, ulangi tiap 4–6 hari sekali.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS & OVERCLAIM HARVEST GALLERY -->
    <section class="bg-slate-50/60 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.2] tracking-normal text-slate-950">
        Bukti Lapangan: <span class="hl-brush">Panen Rekor Saat Harga Cabai Melangit</span>
      </h2>

      <div class="mt-5 space-y-5">
        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src={`/images/landing/${SLUG}/testi-1.webp`}
            alt="Cak Sutris, Pare, Kediri"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-4">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[15px] font-bold text-slate-950">Cak Sutris, Pare, Kediri</h3>
              <span class="rounded bg-emerald-100 px-2.5 py-1 text-[12px] font-bold text-emerald-900">Petik Saat Rp85.000/Kg</span>
            </div>
            <p class="mt-2 text-[14px] leading-relaxed text-slate-700 italic">
              "Harga cabai tembus Rp85.000/kg kemarin, tetangga pusing bunganya rontok kena hujan. Punya saya disemprot Saratoga buahnya tetap lebat bertingkat-tingkat!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src={`/images/landing/${SLUG}/testi-2.webp`}
            alt="Pak Hendra, Temanggung"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-4">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[15px] font-bold text-slate-950">Pak Hendra, Temanggung</h3>
              <span class="rounded bg-emerald-100 px-2.5 py-1 text-[12px] font-bold text-emerald-900">Petikan ke-12 Masih 4 Kw</span>
            </div>
            <p class="mt-2 text-[14px] leading-relaxed text-slate-700 italic">
              "Tangkai bunganya jadi tebal dan hijau banget. Bunga gak ada yang rontok, petikan ke-12 masih dapet 4 kuintal per petak!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src={`/images/landing/${SLUG}/testi-3.webp`}
            alt="Bu Siti, Wongsorejo, Banyuwangi"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-4">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[15px] font-bold text-slate-950">Bu Siti, Wongsorejo, Banyuwangi</h3>
              <span class="rounded bg-emerald-100 px-2.5 py-1 text-[12px] font-bold text-emerald-900">Ori 212 Jadi Buah Semua</span>
            </div>
            <p class="mt-2 text-[14px] leading-relaxed text-slate-700 italic">
              "Bunga cabai rawit Ori 212 saya jadi buah semua. Tiap 4 hari petik gak pernah habis!"
