---
/**
 * Native Landing Page: Booster Pemecah Bunga Durian Alpukat Mangga: Saratoga (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/booster-bunga-buah-tahunan.css';

export const prerender = false;

const SLUG = 'booster-bunga-buah-tahunan';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/booster-bunga-buah-tahunan/hero-problem.webp';
---

<BaseLayout
  title={`Booster Pemecah Bunga Durian Alpukat Mangga: Saratoga - ${Astro.locals.tenant.name}`}
  description="Pecahkan stagnasi pohon durian, alpukat, mangga, dan jeruk yang macet berbunga. Saratoga memacu bunga dompolan serempak dan mengunci tangkai pentil buah."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">UBAH POHON RIMBUN DAUN JADI MESIN BUAH!</span>
          Durian, Alpukat & Mangga Malas Berbunga atau Pentil Rontok Dijamin <span class="hl-brush">BERBUAH DOMPOLAN</span>!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup kocor & semprot <strong class="text-slate-950 font-bold">SARATOGA</strong>, mata ketam bunga pecah serempak di dahan tua, tangkai pentil mengunci kuat tahan hujan, aman tanpa efek kerdil!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan pohon durian alpukat rimbun daun tanpa bunga vs dahan penuh bunga dan pentil buah dengan Saratoga"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Hasil Nyata: Bakal bunga keluar bergerombol 14–21 hari & pentil kelereng terkunci jadi buah!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Pemecah Bunga Generatif</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Bebas Efek Kerdil ZPT</span>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Masalah Utama <span class="hl-brush-red">Kebun Durian, Alpukat & Mangga</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Kenapa pohon sudah besar berumur 4–7 tahun tapi hasilnya belum balik modal:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-bunga-buah-tahunan/gejala-1.webp"
              alt="Cabang pohon alpukat dan durian hanya keluar tunas air daun muda tanpa bakal bunga"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Kejebak Trubus Daun Muda Terus
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Pohon Rimbun Daun Tapi Dahan Kosong Bunga</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Dominasi Nitrogen membuat mata tunas generatif di dahan tua terus tidur (dorman) dan hanya mengeluarkan tunas air.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-bunga-buah-tahunan/gejala-2.webp"
              alt="Bunga dan pentil buah muda durian alpukat mangga rontok berserakan di tanah habis hujan"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Bunga & Pentil Kelereng Rontok 90%
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Begitu Diguyur Hujan Malam, Pentil Gugur Habis</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Munculnya pucuk daun muda saat hujan menyedot habis Kalsium dan Boron dari tangkai pentil sehingga pentil langsung rontok.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON (Full Visual Overclaim) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Macet & Rontok</span> Jadi <span class="hl-brush">Dompolan Lebat</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/booster-bunga-buah-tahunan/overclaim-timeline.webp"
          alt="Tahapan munculnya mata ketam bunga hingga pentil buah mengunci dan buah dompolan lebat dengan Saratoga"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Minggu 3: Mata Ketam</span>
          <span class="text-amber-300">Fase Pentil: Mengunci</span>
          <span class="text-emerald-400">Panen: Dompolan Penuh</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/booster-bunga-buah-tahunan/kondisi-rusak.webp"
            alt="Pohon buah tanpa Saratoga hanya rimbun daun dan bunga rontok di tanah"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Rimbun Daun & Rontok</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Tunas air terus keluar, bunga gugur sisa 2–3 buah.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/booster-bunga-buah-tahunan/kondisi-pulih.webp"
            alt="Dahan pohon durian dan alpukat dengan Saratoga penuh dompolan buah lebat"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Dompolan Buah Jadi</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Bunga pecah serempak dan tangkai pentil kokoh sampai panen.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/booster-bunga-buah-tahunan/saratoga-hero.webp"
          alt="Botol resmi Saratoga Serum Tanaman Premium berhologram asli untuk pemecah bunga"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi SARATOGA Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">SARATOGA Original, Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Serum Fosfat-Kalium Generatif + Boron-Kalsium Pengunci Pentil (500ml & 1L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Booster Buah SARATOGA</span> pada Pohon Tahunan
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Membungakan pohon secara alami tanpa merusak akar seperti paklobutrazol keras:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-bunga-buah-tahunan/overclaim-1.webp"
              alt="Mata ketam dan bakal bunga dompolan keluar rapat di sepanjang dahan durian dan alpukat"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • PECAH MATA KETAM BUNGA
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Bangunkan Tunas Bunga Dorman di Sepanjang Dahan!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Meningkatkan rasio C/N jaringan kayu dan daun tua sehingga dahan mengeluarkan dompolan bunga serempak dalam 2–3 minggu.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-bunga-buah-tahunan/overclaim-2.webp"
              alt="Pentil buah alpukat dan mangga sebesar kelereng menempel kuat dengan tangkai hijau tebal"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • KUNCI TANGKAI PENTIL
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Pentil Sebesar Kelereng & Telur Menempel Kuat Anti-Rontok!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Kalsium dan Boron mikro mempertebal cincin absisi tangkai buah sehingga pentil tahan guncangan hujan angin.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-bunga-buah-tahunan/overclaim-3.webp"
              alt="Dahan pohon alpukat mentega dan durian merunduk penuh buah ukuran super"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • ISI DAGING PULEN TEBAL
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Daging Alpukat Mentega & Pongge Durian Padat Manis!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Memompa kalium dan asam amino ke buah tanpa membuat pohon induk stres atau mati ranting sehabis panen raya.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/booster-bunga-buah-tahunan/macro-proof.webp"
          alt="Detail makro dompolan pentil buah yang sehat dengan tangkai hijau kokoh bebas cincin rontok"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Aman Jangka Panjang: Pohon tetap subur dan berbuah lebat berulang setiap musim!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis</span>
      </h2>

      <div class="-mx-5 my-4">
        <img
          src="/images/landing/booster-bunga-buah-tahunan/aplikasi-kebun.webp"
          alt="Petani kebun buah menyemprotkan Saratoga ke dahan dan bawah daun pohon alpukat"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 items-stretch gap-2.5 text-center">
        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">1</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Takaran</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Induksi bunga: kocor <strong>50 ml/10L</strong> + semprot <strong>35 ml/tangki</strong> (3x).
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">2</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Aplikasi</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Saat bunga mekar: <strong>jeda semprot 7 hari</strong> untuk penyerbukan.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">3</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Interval</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Saat pentil kelereng: semprot <strong>25 ml/tangki</strong> tiap 10 hari.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS & OVERCLAIM HARVEST GALLERY -->
    <section class="bg-slate-50/60 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Bukti Lapangan: <span class="hl-brush">Pohon Macet Jadi Berbuah Lebat</span>
      </h2>

      <div class="mt-5 space-y-5">
        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/booster-bunga-buah-tahunan/testi-1.webp"
            alt="Pak H. Bambang di Malang Jawa Timur berdiri di samping pohon alpukat yang penuh buah"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak H. Bambang, Malang, Jatim</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">80 Pohon Alpukat Lebat</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "80 pohon alpukat mentega umur 4,5 tahun tadinya cuma rimbun daun. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Dikocor & semprot SARATOGA 3 kali, langsung keluar bunga dompolan dan jadi buah!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/booster-bunga-buah-tahunan/testi-2.webp"
            alt="Pak Iwan Setiawan di Parigi Moutong menunjuk dahan durian Montong yang sarat buah"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Iwan Setiawan, Parigi, Sulteng</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">45+ Durian/Pohon</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Musim lalu pentil durian rontok 80% kena hujan. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Sekarang dikawal SARATOGA, tangkai pentilnya tebal dan jadi 45–60 butir per pohon!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/booster-bunga-buah-tahunan/testi-3.webp"
            alt="Pak H. Dede di Majalengka memegang keranjang panen mangga Gedung Gincu"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak H. Dede, Majalengka, Jabar</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Panen di Luar Musim</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Mangga Gedong Gincu berhasil berbunga serempak lebih awal dan <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">tidak rontok kena hujan, harga jual naik berlipat ganda!</strong>"
            </p>
          </div>
        </div>
      </div>

      <!-- Fullwidth Overclaim Panorama -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/booster-bunga-buah-tahunan/hamparan-kebun.webp"
          alt="Hamparan kebun buah alpukat dan durian produktif dengan dahan sarat buah"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-950 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Cocok untuk Durian, Alpukat, Mangga, Jeruk, Kelengkeng & Jambu Air di seluruh Indonesia!
          </p>
        </div>
      </div>

      <!-- 2-Card Final Overclaim Showcase -->
      <div class="mt-5 grid grid-cols-2 items-stretch gap-3">
        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/booster-bunga-buah-tahunan/panen-rekor.webp"
            alt="Keranjang panen penuh buah alpukat mentega durian dan mangga ukuran super"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Fruit-Set Tinggi</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">Bunga jadi buah naik drastis</p>
          </div>
        </div>

        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/booster-bunga-buah-tahunan/panen-2.webp"
            alt="Belahan alpukat mentega kuning tebal pulen berdampingan dengan dompolan buah di pohon"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Daging Tebal Pulen</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">Kualitas buah kelas premium</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-12">
      <div class="px-5 pb-6 text-center">
        <span class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-[11px] font-bold text-emerald-900">
          Garansi Produk Asli {product.productName}
        </span>
        <h2 class="mx-auto mt-2 max-w-[340px] text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Booster Buah Tahunan</span>
        </h2>
        <p class="mx-auto mt-2 max-w-[340px] text-[14px] text-slate-600">
          Pilih ukuran kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}) di bawah. Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        selectedVariantId={cheapest?.id}
        mode="hybrid"
        embedded={true}
      />
    </section>
  </main>

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
