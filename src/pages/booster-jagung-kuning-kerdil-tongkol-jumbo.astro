---
/**
 * Native Landing Page: Bensu Jagung — Solusi Jagung Kuning Kerdil & Booster Tongkol Jumbo Bernas Full Ujung (BENSU)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: bensu-pupuk-cair-organik (ID: 21329)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/booster-jagung-kuning-kerdil-tongkol-jumbo.css';

export const prerender = false;

const SLUG = 'booster-jagung-kuning-kerdil-tongkol-jumbo';

const product =
  (await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '21329'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 0;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/hero-problem.webp';
---

<BaseLayout
  title={`Bensu Jagung: Solusi Jagung Kuning Kerdil & Booster Tongkol Jumbo 10 Ton/Ha - ${Astro.locals.tenant.name}`}
  description="Atasi jagung kuning kerdil (klorosis huruf V) yang macet tumbuh walau sudah dipupuk Urea & Phonska. Bensu hijaukan daun dalam 7 hari & kunci tongkol bernas full ujung."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-24 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">JAGUNG KUNING KERDIL & TONGKOL OMPONG JADI JUMBO!</span>
          Hijaukan Jagung Macet dalam 7 Hari & Kunci <span class="hl-brush">TONGKOL BERNAS FULL UJUNG TEMBUS 10 TON/HA</span>!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Sudah tebar Urea & Phonska berkarung-karung tapi jagung tetap kuning kurus? Semprot & kocor <strong class="text-slate-950 font-bold">BENSU</strong>, buka kunci hara tanah asam, daun menghijau gelap lebar, dan biji oranye terisi padat 18 baris sampai ujung!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan jagung kuning kerdil dan tongkol ompong vs jagung hijau gelap bertongkol jumbo bernas penuh dengan Bensu"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Hasil 5–7 Hari: Daun kuning huruf V berubah hijau gelap & tongkol terisi padat sampai ujung!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Pembuka Kunci Pupuk</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Cocok NK Sumo, P27 & BISI 18</span>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Penyakit Langganan <span class="hl-brush-red">Petani Jagung di Sentra Nasional</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Kenapa di Tuban, Lamongan, Kediri, Grobogan, Lampung Timur, Sumbawa & Bone biaya pupuk makin mahal tapi panen tertahan di 5–6 ton/Ha:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/gejala-1.webp"
              alt="Fase muda 15-30 HST jagung kuning kerdil klorosis huruf V dan batang kurus meski sudah dipupuk Urea"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Fase Muda (15–30 HST): Kuning Kerdil Huruf V
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Sudah Ditebar Urea & Phonska Tapi Tetap Kuning Macet</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Tanah asam mengunci Fosfat & Zinc serta menguras humat tanah. Akibatnya pupuk tabur menguap sia-sia, daun bergaris kuning pucat, dan batang kurus kecil seperti rumput.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/gejala-2.webp"
              alt="Fase pengisian 50-85 HST tongkol jagung kecil dan ompong di ujung tanpa biji"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Fase Pengisian (50–85 HST): Tongkol Ompong Ujung
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Batang Tinggi Tapi Begitu Dikupas Biji Ujung Kosong (Tip Blank)</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Kekurangan Kalium & Boron organik saat keluar rambut jagung membuat pengisian pati berhenti di tengah jalan. Janggel besar tapi pipilan ringan, rendemen anjlok di bawah 6 ton/Ha.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON (Full Visual Overclaim) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Kuning Kerdil</span> Jadi <span class="hl-brush">Tongkol Ganda Bernas</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/overclaim-timeline.webp"
          alt="Tahapan pemulihan jagung kuning kerdil hari ke-0 hingga daun hijau gelap hari ke-14 dan panen tongkol ganda penuh"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 0: Kuning Kerdil</span>
          <span class="text-amber-300">Hari 14: Hijau Kekar</span>
          <span class="text-emerald-400">Panen: Full Ujung</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/kondisi-rusak.webp"
            alt="Kebun jagung tanpa Bensu tumbuh tidak rata kuning kerdil dan tongkol kecil ompong"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa BENSU
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Kerdil & Ompong</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Pupuk terkunci di tanah, batang kurus, panen cuma 5–6 ton/Ha.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/kondisi-pulih.webp"
            alt="Kebun jagung dengan Bensu tumbuh seragam hijau gelap berbatang kokoh dan tongkol jumbo"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai BENSU
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Hijau Kekar & Bernas</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Akar tunjang mencengkeram kuat, tongkol padat 9–11 ton/Ha.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/bensu-hero.webp"
          alt="Botol resmi Bensu Pupuk Cair Organik berhologram asli untuk booster jagung"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/bensu-hero.webp"
          alt="Foto Botol Resmi BENSU Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-cover object-center bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">BENSU Original, Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Asam Amino L-Bebas + Humic-Fulvic Pembuka Kunci Tanah + Kalium-Fosfat-Zinc Pengisi Biji (500ml & 1L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Biostimulan BENSU</span> pada Tanaman Jagung
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Membuka blokade hara tanah asam sehingga pupuk tabur terserap 95% hingga ke tongkol:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/overclaim-1.webp"
              alt="Daun jagung hijau gelap lebar berkilau dan akar tunjang tebal mencengkeram tanah"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • HIJAU GELAP & AKAR TUNJANG KOKOH
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Bebaskan Kunci Tanah Asam, Daun Menghijau Lebar 5–7 Hari!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Humic-Fulvic dan Zinc kelat membebaskan Fosfat yang terkunci di tanah asam, memacu klorofil pekat dan akar tunjang besar anti-rebah diterpa angin.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/overclaim-2.webp"
              alt="Batang jagung kekar menggendong tongkol ganda ukuran jumbo seragam"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • PACU TONGKOL JUMBO & SERAGAM
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Maksimalkan Potensi Genetik NK Sumo, Pioneer P27 & BISI 18!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Asam Amino L-Bebas mempercepat penyerbukan rambut jagung dan menyuplai energi penuh agar tongkol pertama maupun kedua tumbuh besar merata.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/overclaim-3.webp"
              alt="Tongkol jagung kupas dengan biji oranye mengilap padat 18 baris penuh sampai ke ujung tanpa ompong"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • BIJI BERNAS 16–18 BARIS FULL UJUNG
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Janggel Kecil, Biji Oranye Mengilap & Timbangan Super Berat!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Kalium-Fosfat organik memompa karbohidrat dari daun ke seluruh barisan biji sampai pucuk tongkol, bebas ompong dan rendemen pipilan kering melonjak.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/macro-proof.webp"
          alt="Detail makro pangkal batang jagung kekar dengan akar tunjang merah-hijau mencengkeram tanah subur"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Batang Kekar Anti-Rebah: Akar tunjang mencengkeram tanah kuat dan mengangkut hara 2x lebih cepat!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis & Hemat</span>
      </h2>

      <div class="-mx-5 my-4">
        <img
          src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/aplikasi-kebun.webp"
          alt="Petani jagung menyemprotkan Bensu di hamparan kebun jagung pada pagi hari"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 items-stretch gap-2.5 text-center">
        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">1</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">15–20 HST</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Semprot/kocor <strong>35 ml/tangki 16L</strong> untuk atasi kuning kerdil.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">2</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">35–40 HST</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Semprot <strong>35 ml/tangki</strong> menjelang keluar bunga jantan.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">3</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">55–65 HST</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Semprot <strong>40 ml/tangki</strong> untuk pengisian biji full ujung.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS & OVERCLAIM HARVEST GALLERY -->
    <section class="bg-slate-50/60 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Bukti Lapangan: <span class="hl-brush">Dari 5,9 Ton Tembus 10 Ton/Ha</span>
      </h2>

      <div class="mt-5 space-y-5">
        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/testi-1.webp"
            alt="Pak H. Sunarto petani jagung di Tuban Jawa Timur memegang dua tongkol jagung hibrida ukuran jumbo bernas penuh"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak H. Sunarto, Tuban, Jatim</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Tembus 9,8 Ton/Ha</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Jagung NK 212 Sumo umur 20 hari sempat kuning kerdil padahal sudah masuk Urea & Phonska. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Disemprot BENSU 6 hari langsung hijau gelap, panen kemarau kemarin tembus 9,8 ton pipilan kering!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/booster-jagung-kuning-kerdil-tongkol-jumbo/testi-2.webp"
            alt="Pak Slamet Riyadi petani jagung di Grobogan Jawa Tengah berdiri di samping gunungan panen jagung oranye"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Slamet Riyadi, Grobogan, Jateng</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Bebas Tongkol Ompong</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
