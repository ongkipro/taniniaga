---
/**
 * Native Landing Page: Penakluk Sawit Ganoderma (AUSSIE)
 *
 * Visual Pattern: Inspired by bangkitkan-tanaman-mandek
 * Master Product: aussie-pupuk-cair-organik (ID: 26039)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/penakluk-sawit-ganoderma.css';

export const prerender = false;

const SLUG = 'penakluk-sawit-ganoderma';

const product =
  (await getStorefrontProduct(Astro.locals, 'aussie-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '26039'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/penakluk-sawit-ganoderma/hero-problem.webp';
---

<BaseLayout
  title={`Obat Sawit Ganoderma & Daun Kuning Sengkleh: Solusi Pupus Segar & TBS Jumbo | ${Astro.locals.tenant.name}`}
  description="Solusi darurat kelapa sawit terserang jamur Ganoderma, busuk pangkal batang, dan pelepah kuning sengkleh. Aktifkan imun sawit, kunci jamur, pulihkan TBS lebat."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={false}
>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector=""
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <!-- 1. HERO SECTION (High-Impact Mobile First-Fold / Stop Scrolling Hook) -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-8">
        <h1 class="mx-auto max-w-[440px] text-[clamp(28px,7.8vw,34px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight">JANGAN DITEBANG DULU!</span>
          Sawit Kuning & Rawan Ganoderma Dijamin <span class="hl-brush">PUPUS SEGAR</span> & Pelepah Hijau Tegap
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[15.5px] font-medium leading-relaxed text-slate-700">
          Cukup kocor piringan & semprot pangkal batang <strong class="text-slate-950 font-bold">AUSSIE</strong>, jamur Ganoderma terkunci, pangkal batang kebal busuk, dan TBS kembali lebat berbobot tanpa rugi tebang pohon!
        </p>
      </div>

      <div class="mt-6">
        <!-- Hero Image: Fullwidth Edge-to-Edge with Proof Banner Overlay -->
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi kelapa sawit busuk Ganoderma vs pulih hijau berbuah lebat sehabis aplikasi AUSSIE"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/80 px-4 py-2.5 text-center backdrop-blur-sm">
            <p class="text-[12.5px] font-bold text-[#BBF7D0]">
              Hasil Nyata: Daun kuning sengkleh pulih hijau tegap, pangkal batang kebal busuk Ganoderma!
            </p>
          </div>
        </div>

        <!-- Trust Points Row -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 px-4 text-[12px] font-semibold text-slate-700">
          <span>Immune Cellactivator</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Formula Sawit High-End</span>
        </div>

        <!-- Takeaway Box with left accent border -->
        <div class="mt-5 mx-5 text-left border-l-2 border-emerald-600 pl-4 bg-emerald-50/40 py-2.5 pr-3 rounded-r">
          <p class="text-[14.5px] font-bold text-slate-950">Pohon sawit terserang jamur Ganoderma jangan buru-buru ditebang atau dibakar!</p>
          <p class="text-[13px] leading-relaxed text-slate-600 mt-1">
            Sebelum batang keropos total, aktifkan sistem imunitas tanaman dengan salisilat dan asam amino organik AUSSIE. Hifa jamur Ganoderma terkunci mati, pupus muda langsung membuka tegap, dan TBS kembali berondol lebat.
          </p>
        </div>
      </div>
    </section>

    <!-- 2. HARD PROBLEM SECTION (Fakta Lapangan Jamur Ganoderma) -->
    <section class="bg-red-50/30 px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Kenapa Sawit Bisa <span class="hl-brush-red">Kuning Sengkleh</span> & Tumbang Ganoderma?
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Banyak pemilik kebun terlambat menyadari gejala awal Ganoderma sampai pohon tiba-tiba tumbang keropos di piringan:
      </p>

      <div class="space-y-4">
        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">1. Serangan Miselium Ganoderma dari Dalam</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Jamur <em>Ganoderma boninense</em> menyerang jaringan pembuluh kayu di pangkal batang. Dari luar terlihat biasa, namun bagian dalam batang sudah membusuk basah dan mengeluarkan jamur kipas cokelat.</p>
        </div>

        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">2. Pelepah Tua Sengkleh & Menguning</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Karena saluran xilem tersumbat miselium jamur, pasokan air dan unsur hara terputus. Pelepah tua menguning terkulai lemas seperti payung patah, pupus muda membusuk (spear rot).</p>
        </div>

        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">3. Tanah Gambut Masam & Akar Serap Mati</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Kondisi tanah gambut yang sangat masam dan drainase buruk mempercepat penularan spora jamur antar akar. Akibatnya buah menjadi landak/cengkeh dan produksi TBS merosot tajam!</p>
        </div>
      </div>
    </section>

    <!-- 3. PHYSICAL COMPARISON SECTION (Perbandingan Fisik Lapangan) -->
    <section class="bg-white px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Bedanya Nyata: <span class="hl-brush-red">Busuk Ganoderma</span> vs <span class="hl-brush">TBS Berbobot</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Sawit yang dibiarkan tanpa imunitas akan tumbang dan menular ke pokok sebelah. Tapi begitu sel imunnya diaktifkan dengan AUSSIE, pemulihannya nyata di kebun:
      </p>

      <div class="grid grid-cols-2 gap-3.5">
        <!-- Card Bad (Kondisi Ganoderma) -->
        <div class="relative overflow-hidden bg-slate-50/60 rounded-lg border border-slate-100 shadow-sm">
          <img
            src="/images/landing/penakluk-sawit-ganoderma/kondisi-rusak.webp"
            alt="Kondisi pangkal batang kelapa sawit busuk terserang jamur Ganoderma"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm">
            Serangan Ganoderma
          </div>
          <div class="p-3">
            <h3 class="text-[13px] font-bold text-slate-900">Batang Busuk & Pelepah Patah</h3>
            <p class="text-[11.5px] text-slate-500 mt-0.5 leading-relaxed">
              Pangkal batang berjamur keropos, daun kuning sengkleh, TBS anjlok nol.
            </p>
          </div>
        </div>

        <!-- Card Good (Hasil Aplikasi AUSSIE) -->
        <div class="relative overflow-hidden bg-slate-50/60 rounded-lg border border-slate-100 shadow-sm">
          <img
            src="/images/landing/penakluk-sawit-ganoderma/kondisi-pulih.webp"
            alt="Kondisi kelapa sawit pulih sehat pelepah tegap berbuah lebat"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm">
            Hasil Aplikasi AUSSIE
          </div>
          <div class="p-3">
            <h3 class="text-[13px] font-bold text-emerald-800">Pupus Segar & TBS Melimpah</h3>
            <p class="text-[11.5px] text-slate-600 mt-0.5 leading-relaxed">
              Pelepah tegap hijau pekat, pupus baru aktif, tandan buah padat berondol segar.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. PRODUCT SPECIFICATION & KNOWLEDGE (Solusi Produk AUSSIE) -->
    <section class="bg-white px-5 py-10">
      <!-- Fullwidth Product Banner -->
      <div class="-mx-5 mb-8">
        <img
          src="/images/landing/penakluk-sawit-ganoderma/aussie-hero.webp"
          alt="Botol Nutrisi Fungisida Organik AUSSIE di Lahan Perkebunan Kelapa Sawit"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        AUSSIE — Nutrisi Fungisida <span class="hl-brush">Immune Cellactivator</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        AUSSIE adalah formula bioaktif High-End dengan Teknologi Hybrid yang memadukan Immune Cellactivator, Asam Salisilat alami, Asam Amino esensial, dan ekstrak organik penguat sel. Bekerja ganda: memicu <em>Systemic Acquired Resistance</em> (SAR) agar sel tanaman kebal terhadap penetrasi jamur Ganoderma, Curvularia, dan busuk pupus, sekaligus menyuplai energi hara instan untuk memulihkan pelepah kuning menjadi hijau tegap.
      </p>

      <div class="mt-8 space-y-5">
        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Mengunci & Menghentikan Miselium Ganoderma</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Menghambat enzim perusak dinding sel yang diproduksi jamur Ganoderma, mencegah pembusukan meluas ke jaringan inti pembuluh batang sawit.
          </p>
        </div>

        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Memicu Pupus Baru & Menegakkan Pelepah</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Kandungan salisilat dan asam amino organik langsung membuka stomata dan transportasi hara, memicu keluarnya pupus baru yang hijau pekat dan tegap.
          </p>
        </div>

        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Mempertebal Dinding Sel & Mengisi Bobot TBS</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Mengoptimalkan fotosintesis di pelepah, menjadikan bunga betina berkembang sempurna menjadi tandan buah segar (TBS) super padat dengan rendemen tinggi.
          </p>
        </div>
      </div>

      <!-- Macro Shoot Explosion Photo Banner (Fullwidth Edge-to-Edge) -->
      <div class="-mx-5 mt-8 relative">
        <img
          src="/images/landing/penakluk-sawit-ganoderma/pupus-segar.webp"
          alt="Foto makro pupus daun muda kelapa sawit segar membuka tegap sehabis aplikasi AUSSIE"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900/90 py-2.5 px-4 text-center">
          <p class="text-[12px] font-bold text-[#BBF7D0]">
            Hasil 3 Minggu: Pupus muda segar membuka hijau tegap, sistem imunitas sawit pulih maksimal.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. HOW IT WORKS / CARA APLIKASI LAHAN -->
    <section class="bg-emerald-50/20 px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        SOP Sederhana & <span class="hl-brush">Cepat Dipraktekkan</span> di Kebun
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Nggak perlu alat berat atau penanganan rumit. Cukup aplikasi semprot kabut dan kocor di piringan sawit:
      </p>

      <!-- Fullwidth Photo: Aplikasi Semprot Kocor Sawit -->
      <div class="-mx-5 mb-8 mt-2">
        <img
          src="/images/landing/penakluk-sawit-ganoderma/aplikasi-sawit.webp"
          alt="Petani menyemprot kabut nutrisi AUSSIE di piringan dan batang kelapa sawit"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Vertical Timeline Cards -->
      <div class="relative border-l-2 border-emerald-100/80 pl-7 space-y-4 ml-2 mt-6">
        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            1
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Takaran Dosis Efektif</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Campurkan 3-5 tutup botol AUSSIE (50-80 ml) ke dalam 1 tangki semprot (16-20 liter air bersih). Untuk pokok bergejala parah, gunakan 100 ml per 10 liter air untuk kocor piringan.
          </p>
        </div>

        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            2
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Kocor Piringan & Semprot Batang</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Siramkan merata ke piringan akar aktif dan semprotkan kabut basah ke sekeliling pangkal batang setinggi 1 sampai 1,5 meter dari tanah di pagi atau sore hari.
          </p>
        </div>

        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            3
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Ulangi Selang 2-3 Minggu</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Cukup 2-3 kali aplikasi bertahap, hifa jamur Ganoderma terkunci mati, pelepah yang tadinya kuning lemas kembali hijau tegap, dan pupus baru keluar segar!
          </p>
        </div>
      </div>
    </section>

    <!-- 7. TESTIMONIALS SECTION (Hasil Nyata di Kebun Petani) -->
    <section class="bg-white px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Kisah Nyata Petani: <span class="hl-brush">Kebun Selamat & Panen Meledak</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-8">
        Ratusan petani sawit di Riau, Sumut, dan Kalimantan membuktikan sendiri pokok sawitnya bangkit dari Ganoderma tanpa rugi tebang pohon:
      </p>

      <div class="space-y-8">
        <!-- Testimoni 1: Pak Syamsuddin -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Syamsuddin (54 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">KUD Sawit Makmur, Ujung Batu, Rokan Hulu, Riau</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Sawit Marihat Umur 9 Tahun • Gejala Ganoderma & Busuk Batang</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/penakluk-sawit-ganoderma/testi-1.webp"
              alt="Dokumentasi kelapa sawit Pak Syamsuddin pulih dari Ganoderma dan berbuah lebat di Riau"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Ada 18 pokok sawit saya di blok ujung yang kena jamur Ganoderma, batangnya bawah keropos dan pelepahnya menguning sengkleh kayak mau roboh. <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 text-slate-950 font-semibold">Sudah disarankan mandor tebang bakar</strong>. Begitu saya coba kocor AUSSIE rutin 3 kali, <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">sebulan kemudian pangkal batangnya mengering dan berhenti busuk!</strong> Pelepah atasnya jegrik hijau tua lagi, sekarang buahnya keluar mutar padat!"
          </p>

          <div class="pt-4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
        </div>

        <!-- Testimoni 2: Pak Marbun -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Marbun (49 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Harapan Tani, Bilah Hilir, Labuhanbatu, Sumatera Utara</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Sawit Dami Mas • Tanah Gambut Kuning Sengkleh</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/penakluk-sawit-ganoderma/testi-2.webp"
              alt="Dokumentasi kelapa sawit Pak Marbun pelepah hijau tegap di lahan gambut Labuhanbatu"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Lahan gambut bikin sawit langganan kuning pucat dan buahnya sering landak kurus. <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 text-slate-950 font-semibold">Dipupuk kimia berulang kali tetap mandek</strong>. Sejak pakai AUSSIE disiramkan ke piringan dan semprot batang, <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">daunnya berubah jadi hijau gelap tebal</strong>. Pelepah gak gampang patah dan berat tandan TBS pas ditimbang di RAM naik rata-rata 3 sampai 4 kilo per janjang!"
          </p>

          <div class="pt-4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
        </div>

        <!-- Testimoni 3: Pak Gusti -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Gusti (45 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Kelompok Tani Mandiri, Kendawangan, Ketapang, Kalimantan Barat</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Sawit Sriwijaya • TBM Busuk Pupus & Curvularia</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/penakluk-sawit-ganoderma/testi-3.webp"
              alt="Dokumentasi kelapa sawit muda Pak Gusti pulih dari busuk pupus di Ketapang Kalbar"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Sawit muda umur 3 tahun sempat kena busuk pupus dan bercak daun Curvularia parah sehabis musim hujan lebat. Disemprot AUSSIE 2 kali selang dua minggu, <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">pupus barunya langsung mencuat sehat tanpa cacat</strong>. Batangnya makin bulat kokoh dan pertumbuhannya melesat cepat."
          </p>
        </div>
      </div>

      <!-- Panorama Hamparan Kebun Pulih (Fullwidth Edge-to-Edge) -->
      <div class="-mx-5 mt-10 relative">
        <img
          src="/images/landing/penakluk-sawit-ganoderma/hamparan-kebun.webp"
          alt="Foto panorama hamparan kebun kelapa sawit subur hijau royo-royo bebas Ganoderma"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900/90 py-2.5 px-4 text-center">
          <p class="text-[12px] font-bold text-[#BBF7D0]">
            Kebun Sawit Sehat: Hamparan kebun sawit hijau royo-royo bebas Ganoderma, pelepah membuka tegap dan produktivitas TBS terjaga.
          </p>
        </div>
      </div>

      <!-- Inset Card Bukti Panen TBS Jumbo -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-100 bg-slate-50/50 shadow-sm">
        <img
          src="/images/landing/penakluk-sawit-ganoderma/panen-tbs-jumbo.webp"
          alt="Foto hasil panen tandan buah segar kelapa sawit super jumbo"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="p-3 text-center">
          <p class="text-[13px] font-semibold text-slate-800">
            Hasil Panen TBS Jumbo: Daun sehat dan batang kokoh menghasilkan tandan buah segar berondol padat dengan rendemen minyak tinggi.
          </p>
        </div>
      </div>
    </section>

    <!-- 8. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-12">
      <div class="px-5 pb-6 text-center">
        <h2 class="mx-auto max-w-[340px] text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Penyelamat Sawit</span>
        </h2>
        <p class="mx-auto mt-2 max-w-[340px] text-[14px] text-slate-600">
          Isi alamat pengiriman di bawah untuk menerima paket langsung di rumah. Bayar saat barang sampai (COD).
        </p>
      </div>

      <GeoIpResolvedForm productSlug={product.slug} mode="hybrid" embedded={true} />
    </section>
  </main>

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
