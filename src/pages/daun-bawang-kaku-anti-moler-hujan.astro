---
/**
 * Native Landing Page: Daun Bawang Kaku Tegak Kalis Hujan! Kebal Moler & Trotol sampai Panen - Kojien (KOJIEN)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: kojien (ID: 99118)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/daun-bawang-kaku-anti-moler-hujan.css';

export const prerender = false;

const SLUG = 'daun-bawang-kaku-anti-moler-hujan';

const product =
  (await getStorefrontProduct(Astro.locals, 'kojien')) ??
  (await getStorefrontProduct(Astro.locals, '99118'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/daun-bawang-kaku-anti-moler-hujan/hero-problem.webp';
---

<BaseLayout
  title={`Daun Bawang Kaku Tegak Kalis Hujan! Kebal Moler & Trotol sampai Panen - Kojien - ${Astro.locals.tenant.name}`}
  description="Bawang merah kebal penyakit layu moler Fusarium dan bercak trotol ungu. Kojien lapisi daun jadi kalis seperti daun talas, daun pipa berdiri tegak kaku 90 derajat."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-4 text-center">
      <div class="px-5 pt-5">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.2] tracking-normal text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-normal text-[18px] font-extrabold uppercase">BENTENG SILIKA NANO — DAUN TEGAK KALIS AIR, BEBAS MOLER!</span>
          Daun Bawang Kaku Tegak Kalis Hujan! <span class="hl-brush">Kebal Moler & Trotol</span> Sampai Panen!
        </h1>
        <p class="mx-auto mt-3 max-w-[410px] text-[15px] font-normal leading-relaxed text-slate-700">
          Takut daun bawang lemas terpelintir layu moler (Fusarium) dan trotol bintik hitam saat hujan asam? KOJIEN dengan Silika Aktif 98% melapisi daun bawang menjadi licin kalis seperti daun talas, mempertebal dinding sel hingga kaku tegak 90 derajat, kebal jamur dan tahan panen!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Daun bawang merah berdiri kaku tegak kalis air hujan bebas moler dan trotol"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2.5 text-center backdrop-blur-sm">
            <p class="text-[13px] font-bold text-[#BBF7D0]">
              Hasil Demplot Brebes & Probolinggo: Daun pipa kaku berlilin 90°, air hujan bablas, 0% moler!
            </p>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 px-4 text-[13px] font-semibold text-slate-800">
          <span>Efek Daun Talas Penolak Hujan</span>
          <span class="text-slate-300">•</span>
          <span>Dinding Sel Tebal Kaku</span>
          <span class="text-slate-300">•</span>
          <span>100% Kebal Moler & Trotol</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD Bayar di Tempat</span>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.2] tracking-normal text-slate-950">
        2 Serangan Maut <span class="hl-brush-red">Bawang Merah</span> di Musim Hujan
      </h2>
      <p class="text-[15px] text-slate-700 mt-2 mb-5 leading-relaxed">
        Air hujan yang menempel di daun bawang menjadi jembatan utama spora jamur mematikan:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src={`/images/landing/${SLUG}/gejala-1.webp`}
              alt="Daun bawang merah layu meliuk terpelintir akibat serangan jamur Fusarium"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-1 text-[12px] font-bold text-white shadow">
              1. Layu Moler Melintir
            </span>
          </div>
          <div class="p-4">
            <h3 class="text-[16px] font-bold text-slate-950">Daun Bawang Terpelintir Melingkar & Pangkal Batang Busuk</h3>
            <p class="text-[13px] text-slate-600 mt-1.5 leading-relaxed">
              Spora Fusarium oxysporum berkembang biak saat daun lembap, melumpuhkan pangkal batang hingga daun melingkar seperti per dan layu total.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src={`/images/landing/${SLUG}/gejala-2.webp`}
              alt="Bercak trotol bercincin konsentris merusak daun pipa bawang merah"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-1 text-[12px] font-bold text-white shadow">
              2. Bercak Ungu Trotol
            </span>
          </div>
          <div class="p-4">
            <h3 class="text-[16px] font-bold text-slate-950">Bercak Ungu Kehitaman Melepuh & Pucuk Kering Terbakar</h3>
            <p class="text-[13px] text-slate-600 mt-1.5 leading-relaxed">
              Serangan Alternaria porri (trotol) melubangi kutikula daun yang tipis, menyebabkan daun patah lemas sebelum masa pengisian umbi.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON (Full Visual Overclaim) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.2] tracking-normal text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Daun Moler Lemas</span> Jadi <span class="hl-brush">Pipa Kaku Berlilin</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src={`/images/landing/${SLUG}/overclaim-timeline.webp`}
          alt="Progres pemulihan tanaman bawang merah dari daun melintir menjadi daun kaku tegak"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[12px] font-bold py-2.5 px-2 border-t border-slate-800">
          <span class="text-red-400">24 Jam: Air Hujan Tergelincir</span>
          <span class="text-amber-300">3 Hari: Daun Pipa Kaku Berdiri</span>
          <span class="text-emerald-400">Panen: Bebas Rebah & Umbi Utuh</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src={`/images/landing/${SLUG}/kondisi-rusak.webp`}
            alt="Tanaman bawang merah tanpa Kojien daun lemas terpelintir moler"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2.5 py-1 text-[12px] font-bold text-white shadow">
            Tanpa KOJIEN
          </div>
          <div class="flex flex-1 flex-col justify-center p-3.5">
            <h3 class="text-[14px] font-bold leading-tight text-slate-900">Moler & Daun Lemas</h3>
            <p class="mt-1 text-[13px] leading-snug text-slate-600">
              Daun meliuk terpelintir, bercak trotol merata, umbi gagal terbentuk.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src={`/images/landing/${SLUG}/kondisi-pulih.webp`}
            alt="Tanaman bawang merah dengan Kojien daun pipa berdiri kaku tegak hijau"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2.5 py-1 text-[12px] font-bold text-white shadow">
            Pakai KOJIEN
          </div>
          <div class="flex flex-1 flex-col justify-center p-3.5">
            <h3 class="text-[14px] font-bold leading-tight text-emerald-900">Daun Kaku Kalis Hujan</h3>
            <p class="mt-1 text-[13px] leading-snug text-slate-700">
              Daun pipa berdiri tegak 90 derajat, kalis air hujan, kebal serangan jamur.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer / Field Shot -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src={`/images/landing/${SLUG}/kojien-hero.webp`}
          alt="Botol resmi Kojien Pupuk Silika Organik Premium berhologram asli di kebun"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge (Guaranteed local asset) -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-3 shadow-sm">
        <img
          src={`/images/landing/${SLUG}/product-packshot.webp`}
          alt="Foto Botol Resmi KOJIEN Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-white border border-emerald-100 p-1"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[13px] font-bold text-emerald-950">KOJIEN Original, Segel Hologram Resmi</p>
          <p class="text-[12px] text-slate-600 leading-snug mt-0.5">
            Silika Cair Bio-Aktif Larut Air 98% + Surfaktan Alami Pelapis Kutikula (Kemasan Resmi 500ml & 1 Liter).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.2] tracking-normal text-slate-950">
        3 Perisai Mutlak <span class="hl-brush">Kojien Pelapis Daun Bawang</span>
      </h2>
      <p class="text-[15px] text-slate-700 mt-2 mb-5 leading-relaxed">
        Menjadikan permukaan daun bawang benteng baja yang licin dan mustahil ditembus jamur:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src={`/images/landing/${SLUG}/overclaim-1.webp`}
              alt="Butiran air hujan menggelinding jatuh di permukaan daun bawang merah"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-4 pb-3 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2.5 py-1 text-[12px] font-bold text-white shadow">
                EFEK 1 • EFEK DAUN TALAS SEKETIKA
              </span>
              <h3 class="text-[16px] font-bold text-white mt-1.5 leading-snug">
                Air Hujan Asam & Embun Kabut 100% Menggelinding Jatuh!
              </h3>
            </div>
          </div>
          <p class="p-3.5 text-[14px] text-slate-700 leading-relaxed">
            Membentuk lapisan silika kristalin ultra-tipis yang membuat air tidak bisa menempel dan langsung tergelincir jatuh ke tanah.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src={`/images/landing/${SLUG}/overclaim-2.webp`}
              alt="Hamparan daun pipa bawang merah berdiri kaku tegak seragam"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-4 pb-3 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2.5 py-1 text-[12px] font-bold text-white shadow">
                EFEK 2 • DAUN KAKU SEKERAS KAWAT
              </span>
              <h3 class="text-[16px] font-bold text-white mt-1.5 leading-snug">
                Daun Pipa Berdiri Tegak 90°, Kebal Dihantam Angin Badai!
              </h3>
            </div>
          </div>
          <p class="p-3.5 text-[14px] text-slate-700 leading-relaxed">
            Silika nano diserap langsung ke dinding sel epidermis, mengeraskan struktur daun pipa seperti pipa baja kokoh.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src={`/images/landing/${SLUG}/overclaim-3.webp`}
              alt="Daun bawang mulus bebas bercak jamur sampai masa panen"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-4 pb-3 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2.5 py-1 text-[12px] font-bold text-white shadow">
                EFEK 3 • BENTENG PERISAI ANTI-TEMBUS
              </span>
              <h3 class="text-[16px] font-bold text-white mt-1.5 leading-snug">
                Spora Moler & Trotol Gagal Total Menembus Dinding Sel!
              </h3>
            </div>
          </div>
          <p class="p-3.5 text-[14px] text-slate-700 leading-relaxed">
            Hifa jamur Fusarium dan Alternaria patah saat berusaha melubangi dinding sel yang telah mengalami silisifikasi sempurna.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src={`/images/landing/${SLUG}/macro-proof.webp`}
          alt="Detail mikroskopis silika pelapis permukaan daun bawang"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2.5 px-4 text-center">
          <p class="text-[13px] font-bold text-[#BBF7D0]">
            Silika Kristalin Aktif: Butiran air hujan menggelinding sempurna, spora jamur mati kekeringan!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.2] tracking-normal text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis</span>
      </h2>

      <div class="-mx-5 my-4">
        <img
          src={`/images/landing/${SLUG}/aplikasi-kebun.webp`}
          alt="Aplikasi semprot kabut di lahan pertanian"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 items-stretch gap-2.5 text-center">
        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[12px] font-bold text-white">1</span>
          <h3 class="mt-2 text-[13px] font-bold leading-tight text-slate-900">Takaran</h3>
          <p class="mt-1 text-[12px] leading-snug text-slate-700">
            Gunakan 15–20 ml Kojien per tangki 16 Liter.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[12px] font-bold text-white">2</span>
          <h3 class="mt-2 text-[13px] font-bold leading-tight text-slate-900">Aplikasi</h3>
          <p class="mt-1 text-[12px] leading-snug text-slate-700">
            Semprot kabut halus merata pada daun pagi hari setelah embun atau sore hari.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[12px] font-bold text-white">3</span>
          <h3 class="mt-2 text-[13px] font-bold leading-tight text-slate-900">Interval</h3>
          <p class="mt-1 text-[12px] leading-snug text-slate-700">
            Aplikasi mulai 15 HST, ulangi tiap 4–6 hari sekali terutama di musim hujan.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS & OVERCLAIM HARVEST GALLERY -->
    <section class="bg-slate-50/60 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.2] tracking-normal text-slate-950">
        Bukti Lapangan: <span class="hl-brush">Bawang Bebas Moler Panen Sempurna</span>
      </h2>

      <div class="mt-5 space-y-5">
        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src={`/images/landing/${SLUG}/testi-1.webp`}
            alt="Pak Subhan, Wanasari, Brebes"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-4">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[15px] font-bold text-slate-950">Pak Subhan, Wanasari, Brebes</h3>
              <span class="rounded bg-emerald-100 px-2.5 py-1 text-[12px] font-bold text-emerald-900">0% Moler di Rendeng</span>
            </div>
            <p class="mt-2 text-[14px] leading-relaxed text-slate-700 italic">
              "Musim rendeng biasanya daun bawang saya moler melintir kayak per. Sejak semprot Kojien, daunnya kaku kayak kawat berdiri tegak, air hujan bablas!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src={`/images/landing/${SLUG}/testi-2.webp`}
            alt="Pak Marno, Bagor, Nganjuk"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-4">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[15px] font-bold text-slate-950">Pak Marno, Bagor, Nganjuk</h3>
              <span class="rounded bg-emerald-100 px-2.5 py-1 text-[12px] font-bold text-emerald-900">Daun Mulus Umur 60 HST</span>
            </div>
            <p class="mt-2 text-[14px] leading-relaxed text-slate-700 italic">
              "Bercak trotol biasanya bikin daun kering kebakar. Pakai Kojien daun tetap hijau mulus sampai umur 60 HST!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src={`/images/landing/${SLUG}/testi-3.webp`}
            alt="Mas Anton, Dringu, Probolinggo"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-4">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[15px] font-bold text-slate-950">Mas Anton, Dringu, Probolinggo</h3>
              <span class="rounded bg-emerald-100 px-2.5 py-1 text-[12px] font-bold text-emerald-900">Tetangga Rebah Saya Tegak</span>
            </div>
            <p class="mt-2 text-[14px] leading-relaxed text-slate-700 italic">
              "Pohon bawang tetangga pada rebah kena hujan angin, petak saya tetap berdiri tegak royo-royo!"
