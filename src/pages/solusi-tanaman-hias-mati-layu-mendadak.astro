---
/**
 * Native Landing Page: Pertolongan Darurat Tanaman Hias Mati Layu Mendadak (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/solusi-tanaman-hias-mati-layu-mendadak.css';

export const prerender = false;

const SLUG = 'solusi-tanaman-hias-mati-layu-mendadak';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 0;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/solusi-tanaman-hias-mati-layu-mendadak/hero-problem.webp';
---

<BaseLayout
  title={`Pertolongan Darurat Tanaman Hias Mati Layu Mendadak & Lonyot: Saratoga - ${Astro.locals.tenant.name}`}
  description="Atasi sekarang tanaman hias jutaan rupiah yang mengalami mati layu mendadak, tangkai daun lemas semalam, pelepah lonyot berair, dan busuk akar spot merah dengan serum SARATOGA."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-24 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">ATASI SEKARANG JANGAN SAMPAI RUGI JUTAAN!</span>
          Tanaman Hias Mati Layu Mendadak & Tangkai Lemas Semalam Dijamin <span class="hl-brush">TEGAK SEGAR & BATAL BUSUK TOTAL</span>!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Sore masih segar, pagi tiba-tiba terkulai lemas dan pelepah bawah mulai berair? Kocor bonggol & kabut daun dengan <strong class="text-slate-950 font-bold">SARATOGA</strong> sekarang sebelum lonyot menjalar ke bonggol utama dan koleksi jutaan habis tak bersisa!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan koleksi tanaman hias aglonema dan monstera mati layu mendadak vs pulih tegak segar setelah penyelamatan darurat SARATOGA"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Penyelamatan Darurat 48 Jam: Tangkai terkulai kembali tegak kaku & lonyot berhenti menjalar!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Resusitasi Sel & Pembuluh</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Aman Tanpa Bau Amis</span>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Gejala Darurat <span class="hl-brush-red">Mati Layu Mendadak di Pot</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Jangan dikira kurang air lalu disiram terus—justru 2 pemicu ini yang membuat bonggol busuk total dalam 48 jam:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/gejala-1.webp"
              alt="Gejala tangkai daun aglonema dan philodendron terkulai lemas seperti payung dengan pelepah bawah menguning berair lonyot"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Tangkai Rebah Payung & Pelepah Bawah Berair
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Tekanan Sel (Turgor) Hilang Mendadak & Bakteri Lonyot Naik</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Pelepah bawah menguning bening berair dan lembek saat dipencet, membuat seluruh tangkai daun menekuk jatuh dalam semalam.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/gejala-2.webp"
              alt="Bonggol bawah dan perakaran tanaman hias mengalami busuk akar hitam serta stres pembuluh akibat cuaca ekstrem"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Syok Cuaca Ekstrem, Busuk Akar & Spot Merah
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Panas Terik Lanjut Hujan Deras Bikin Pembuluh Batang Kolaps</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Suhu media pot yang lembab pengap memicu vascular shock dan infeksi busuk akar yang cepat merembet naik ke bonggol utama.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON (Full Visual Overclaim) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Layu Mendadak</span> Jadi <span class="hl-brush">Tegak Kaku Kokoh</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/overclaim-timeline.webp"
          alt="Tahapan penyelamatan tanaman hias dari Jam 0 terkulai layu hingga 48 Jam tangkai tegak kembali dan Hari 14 pecah akar tunas baru"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Jam 0: Layu Semalam</span>
          <span class="text-amber-300">48 Jam: Tangkai Tegak</span>
          <span class="text-emerald-400">Hari 14: Bonggol Sehat</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/kondisi-rusak.webp"
            alt="Tanaman hias koleksi mati layu mendadak dengan tangkai patah terkulai dan daun menguning lonyot"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Telat Ditangani
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Lonyot ke Bonggol</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Tangkai rebah semua, batang berair busuk & rugi jutaan rupiah.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/kondisi-pulih.webp"
            alt="Koleksi tanaman hias aglonema dan monstera kembali berdiri tegak kokoh dengan daun tebal mengilap setelah aplikasi SARATOGA"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Kocor SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Tegak & Batal Busuk</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Turgor tangkai pulih kaku, rambatan lonyot kering & bonggol selamat.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Surrounded by Ornamental Plants -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/saratoga-hero.webp"
          alt="Botol Serum Tanaman Premium SARATOGA Asli untuk Pertolongan Darurat Tanaman Hias"
          class="aspect-[4/5] w-full object-cover object-top"
          width="896"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/saratoga-hero.webp"
          alt="Foto Botol Resmi SARATOGA Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-cover object-center bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">SARATOGA Original, Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Resusitasi Seluler Kalium-Fosfat + Kalsium-Silika Mikro + L-Amino Acid (250ml, 500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Resusitasi Darurat SARATOGA</span> Saat Tanaman Layu
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Mengembalikan tekanan pembuluh batang dan menghentikan pembusukan sebelum naik ke titik tumbuh:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/overclaim-1.webp"
              alt="Tangkai daun Aglonema dan Monstera kembali berdiri kaku kokoh menahan daun tebal mengilap"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • PULIHKAN TURGOR TANGKAI 48 JAM
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Tegakkan Kembali Tangkai Daun yang Terkulai Lemas!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Kalium-Fosfat larut mengembalikan tekanan osmotik sel tangkai daun sehingga pelepah yang rebah kembali berdiri kaku dan segar.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/overclaim-2.webp"
              alt="Pangkal bonggol bawah tanaman hias mengering sehat keras bebas rambatan lonyot berair"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • BLOKADE RAMBATAN LONYOT BONGGOL
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Keringkan Jaringan Berair & Kunci Leher Bonggol Tetap Keras!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Ion mineral mikro chelate mempertebal dinding sel pembuluh di pangkal batang agar lonyot tidak menjalar ke bonggol utama.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/overclaim-3.webp"
              alt="Munculnya mata akar putih baru dan tunas segar pada pangkal bonggol tanaman hias yang selamat"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • REGENERASI AKAR PENYELAMAT
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Pacu Mata Akar Putih Baru & Bangkitkan Titik Tumbuh!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Asam Amino L-Bebas menyuplai energi instan siap pakai untuk memicu tumbuhnya bintil akar putih baru pada ruas bonggol yang sehat.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/tunas-spike.webp"
          alt="Foto makro bonggol tanaman hias yang keras sehat dengan bintil akar putih baru dan tunas tegak segar"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Bukti Pemulihan Bonggol: Pangkal batang mengeras sehat, akar putih baru pecah & daun berdiri kaku!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        SOP Darurat <span class="hl-brush">Saat Tanaman Layu Mendadak</span>
      </h2>

      <div class="-mx-5 my-4">
        <img
          src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/aplikasi-hias.webp"
          alt="Kolektor tanaman hias mengocor pangkal bonggol dan menyemprot kabut serum SARATOGA di teras rumah"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 items-stretch gap-2.5 text-center">
        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">1</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Bersihkan</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Kupas pelepah lonyot, larutkan <strong>15–30 ml / 3L air</strong>.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">2</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Kocor & Kabut</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            <strong>Kocor pangkal bonggol</strong> & kabut halus balik daun.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">3</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Interval</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Teduhkan pot & ulangi <strong>tiap 5–7 hari</strong> sampai kokoh.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS & OVERCLAIM SHOWCASE GALLERY -->
    <section class="bg-slate-50/60 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Bukti Kolektor: <span class="hl-brush">Koleksi Jutaan Selamat dari Lonyot</span>
      </h2>

      <div class="mt-5 space-y-5">
        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/testi-1.webp"
            alt="Ibu Hj. Rina di Depok tersenyum lega memegang dua pot Aglonema Sultan Lotus dan Suksom yang kembali tegak segar"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Ibu Hj. Rina, Depok</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Batal Rugi Rp4,5 Juta</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Bangun pagi Aglonema Lotus Delight & Suksom tiba-tiba terkulai semua, pelepah bawah sudah berair. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Dikocor & kabut SARATOGA, 2 hari kemudian tangkai berdiri kaku lagi dan lonyotnya kering berhenti total!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/testi-2.webp"
            alt="Pak Hendra di Tangerang di kebun teras rumahnya bersama koleksi Monstera dan Anthurium yang berdiri kokoh"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Hendra, Tangerang</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">6 Pot Monstera Selamat</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Habis panas terik lanjut hujan deras, 6 pot Monstera Variegata & Anthurium mendadak layu lemas. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Dikocor bonggolnya pakai SARATOGA, dalam 48 jam daun tegak tebal dan seminggu kemudian akar putih keluar banyak!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/testi-3.webp"
            alt="Ibu Wulan di Solo memegang pot Alocasia Amazonica dan Caladium dengan tangkai tegak kokoh"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Ibu Wulan Sari, Solo</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Tangkai Tegak Anti-Rebah</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Alocasia & Caladium hias saya sering tiba-tiba patah leher tangkai kalau cuaca lembab. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Sejak rutin dikawal SARATOGA, batangnya kaku kekar dan umbi bonggolnya sehat bebas busuk!</strong>"
            </p>
          </div>
        </div>
      </div>

      <!-- Fullwidth Overclaim Panorama -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/hamparan-hias.webp"
          alt="Hamparan teras nursery rumahan penuh koleksi aglonema monstera dan anggrek yang berdiri tegak segar sehat"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-950 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Proteksi Koleksi Berharga: Sedia 1 botol SARATOGA di rumah, tenang menghadapi cuaca ekstrem & ancaman lonyot!
          </p>
        </div>
      </div>

      <!-- 2-Card Final Overclaim Showcase -->
      <div class="mt-5 grid grid-cols-2 items-stretch gap-3">
        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/trio-juara.webp"
            alt="Tiga tanaman hias koleksi bernilai tinggi dengan tangkai kokoh kaku daun tebal mengilap dan pangkal bonggol sehat"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Tangkai Kaku Kokoh</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">Bebas rebah payung semalam</p>
          </div>
        </div>

        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/solusi-tanaman-hias-mati-layu-mendadak/panen-2.webp"
            alt="Dua pot Aglonema Red Suksom dan Pride of Sumatra berdiri tegak segar dengan bonggol sehat"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Bonggol Keras Sehat</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">Batal busuk & rugi jutaan</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-12">
      <div class="px-5 pb-6 text-center">
        <span class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-[11px] font-bold text-emerald-900">
          Garansi Produk Asli {product.productName}
        </span>
        <h2 class="mx-auto mt-2 max-w-[340px] text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Darurat SARATOGA</span>
        </h2>
        <p class="mx-auto mt-2 max-w-[340px] text-[14px] text-slate-600">
          Pilih ukuran kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}) di bawah. Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        mode="hybrid"
        embedded={true}
      />
    </section>

    <!-- Floating Bottom CTA Bar (Auto-hides while checkout form is in view) -->
    <div
      id="lp-floating-bar"
      class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full max-w-[480px] items-center justify-between gap-3 border-t border-slate-200/90 bg-white/95 px-4 py-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom))] shadow-[0_-8px_24px_rgba(15,23,42,0.1)] backdrop-blur-md transition-all duration-300"
    >
      <div class="min-w-0">
        <p class="truncate text-[11px] font-semibold text-emerald-800">
          SARATOGA {cheapest?.label ?? '250ml'}–2L
        </p>
        <div class="mt-0.5 flex items-baseline gap-1.5">
          <span class="text-[11px] font-medium text-slate-500">Mulai</span>
          <span class="text-[18px] font-bold leading-none tracking-tight text-slate-950">
            {formatIdr(price)}
          </span>
          {
            comparePrice > price && (
              <span class="hidden min-[440px]:inline text-[12px] font-normal text-slate-400 line-through">
                {formatIdr(comparePrice)}
              </span>
            )
          }
        </div>
      </div>
      <a
        href="#checkout-form"
        class="inline-flex min-h-11 shrink-0 items-center justify-center gap-1.5 rounded-xl bg-[#15803d] px-5 text-[13px] font-bold text-white shadow-[0_4px_12px_rgba(21,128,61,0.28)] transition-colors hover:bg-[#166534] active:scale-[0.98]"
      >
        <span>Pesan Sekarang (COD)</span>
        <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </main>

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });

    function initLpFloatingBar() {
      const bar = document.getElementById('lp-floating-bar');
      const form = document.getElementById('checkout-form');
      if (!bar || !form || !('IntersectionObserver' in window)) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              bar.style.transform = 'translateY(100%)';
              bar.style.opacity = '0';
              bar.style.pointerEvents = 'none';
            } else {
              bar.style.transform = 'translateY(0)';
              bar.style.opacity = '1';
              bar.style.pointerEvents = 'auto';
            }
          });
        },
        { threshold: 0.05 }
      );
      observer.observe(form);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLpFloatingBar);
    } else {
      initLpFloatingBar();
    }
  </script>
</BaseLayout>
