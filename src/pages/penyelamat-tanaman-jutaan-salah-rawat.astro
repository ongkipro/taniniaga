---
/**
 * Native Landing Page: Penyelamat Tanaman Hias Jutaan Rupiah Mati Salah Rawat (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/penyelamat-tanaman-jutaan-salah-rawat.css';

export const prerender = false;

const SLUG = 'penyelamat-tanaman-jutaan-salah-rawat';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 0;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/penyelamat-tanaman-jutaan-salah-rawat/hero-problem.webp';
---

<BaseLayout
  title={`Penyelamat Tanaman Hias Jutaan Mati Salah Rawat: Saratoga - ${Astro.locals.tenant.name}`}
  description="Selamatkan koleksi tanaman hias bernilai jutaan (Aglonema Sultan, Monstera Variegata, Anggrek, Anthurium) yang hampir mati akibat salah media sekam mentah, overwatering, dan stres pindah pot."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-24 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">KOLEKSI JUTAAN JANGAN SAMPAI MATI TAK TERSISA!</span>
          Tanaman Hias Sultan Stres & Rusak Salah Rawat Dijamin <span class="hl-brush">BANGKIT AKAR BARU & DAUN MEWAH</span>!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Aglonema Suksom, Monstera Variegata, Anthurium & Anggrek nyaris mati gara-gara media asam, kebanyakan siram, atau stres pindah pot? Kocor & semprot <strong class="text-slate-950 font-bold">SARATOGA</strong>, akar putih gondrong & daun tegap lagi tanpa bau amis!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan koleksi Monstera Variegata dan Aglonema merah yang layu busuk akar akibat salah rawat vs pulih segar berakar putih sehat dengan SARATOGA"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Bukti Penyelamatan: Akar cokelat lonyot berhenti busuk, akar putih gondrong & mata caling pecah!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Bebas Stres Osmotik Akar</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Bersih Tanpa Bau Amis</span>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Kesalahan Rawat Pemicu <span class="hl-brush-red">Koleksi Jutaan Mati di Pot</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Niat hati menyuburkan tanaman kesayangan, tapi 2 kesalahan ini justru membunuh akar dari dalam pot:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/gejala-1.webp"
              alt="Aglonema dan Anthurium mengalami busuk akar cokelat lonyot akibat media sekam mentah asam dan overwatering"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Media Sekam Asam & Overwatering
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Akar Cokelat Lonyot & Daun Bawah Menguning Satu-Satu</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Sekam mentah yang berfermentasi panas di pot ditambah siram tiap hari membuat media becek asam, menutup oksigen akar hingga membusuk cokelat.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/gejala-2.webp"
              alt="Monstera Variegata dan Anggrek Bulan mengalami repotting shock daun terkulai keriput dan akar angin mengering"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Repotting Shock & Salah Pupuk Kandang/Kimia
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Bongkar Pot Bikin Akar Putus, Daun Kisut & Pucuk Macet</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Bulu akar yang luka sehabis ganti pot makin sekarat ketika langsung diberi pupuk kandang belum matang atau NPK kimia yang membakar sisa akar.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON (Full Visual Overclaim) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Koleksi Sekarat</span> Jadi <span class="hl-brush">Segar Mewah</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/overclaim-timeline.webp"
          alt="Tahapan pemulihan tanaman hias salah rawat dari Hari 0 layu kuning hingga Hari 7 akar putih tumbuh dan Hari 14 pecah tunas segar"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 0: Stres & Layu</span>
          <span class="text-amber-300">Hari 7: Akar Putih</span>
          <span class="text-emerald-400">Hari 14: Pecah Tunas</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/kondisi-rusak.webp"
            alt="Koleksi Aglonema dan Monstera rusak akibat salah rawat dengan daun pucat terkulai dan batang lembek"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Akar Lonyot & Habis</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Akar cokelat membusuk di pot, daun gugur satu-satu sampai mati.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/kondisi-pulih.webp"
            alt="Koleksi Aglonema Suksom, Monstera Variegata, dan Anggrek Bulan pulih segar tegap mengilap setelah terapi SARATOGA"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Akar Putih & Rimbun</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Akar putih gondrong tumbuh cepat, mata caling pecah & daun tebal.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Surrounded by Ornamental Plants -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/saratoga-hero.webp"
          alt="Botol Serum Tanaman Premium SARATOGA Asli untuk Penyelamat Koleksi Tanaman Hias Sultan"
          class="aspect-[4/5] w-full object-cover object-top"
          width="896"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/saratoga-hero.webp"
          alt="Foto Botol Resmi SARATOGA Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-cover object-center bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">SARATOGA Original, Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Serum Bio-Active L-Amino Acid + Fosfat Organik + Mikro Chelate Jepang (250ml, 500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Penyelamat SARATOGA</span> pada Koleksi Stres Berat
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Menyuplai energi sel secara instan tanpa membebani akar yang sedang luka atau busuk:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/overclaim-1.webp"
              alt="Penyerapan nutrisi kabut mikro SARATOGA lewat pori stomata bawah daun Aglonema dan Monstera"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • INFUS NUTRISI LEWAT STOMATA
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Serap Energi Langsung dari Daun Tanpa Beban Osmotik Akar!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Asam Amino L-Bebas murni masuk lewat pori stomata bawah daun dalam hitungan jam sehingga tanaman yang akarnya gundul tetap hidup segar.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/overclaim-2.webp"
              alt="Bonggol Aglonema dan Monstera mengeluarkan akar putih gondrong sehat dan mata caling merah"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • PACU AKAR PUTIH GONDRONG
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Tumbuhkan Akar Putih Baru & Pecahkan Mata Caling Tidur!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Fosfat Organik larut mengaktifkan sel meristem pangkal bonggol untuk menumbuhkan akar putih-pink baru dan membangunkan tunas anakan.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/overclaim-3.webp"
              alt="Koleksi Aglonema Suksom dan Monstera Variegata berdiri kaku tebal mengilap seperti berlapis lilin"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • TURGOR KAKU & PIGMEN TAJAM
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Daun Kisut Kembali Berdiri Tebal Mengilap Tanpa Bau Amis!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Mikro Chelate (Fe, Zn, Mg) memulihkan tekanan air sel daun dan mempertajam mutasi warna merah/variegata secara bersih di teras rumah.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/tunas-spike.webp"
          alt="Foto makro ujung akar putih sehat gondrong, mata caling merah Aglonema pecah, dan pucuk Monstera membuka segar"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Respon 7–14 Hari: Ujung akar putih sehat bermunculan, mata caling pecah, dan daun baru membuka mulus!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis & Higienis</span>
      </h2>

      <div class="-mx-5 my-4">
        <img
          src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/aplikasi-hias.webp"
          alt="Hobiis tanaman hias menyemprotkan kabut halus SARATOGA ke bagian bawah daun Monstera dan Aglonema di teras rumah"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 items-stretch gap-2.5 text-center">
        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">1</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Takaran</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Campur <strong>1 tutup (15 ml)</strong> per 2–3 liter air bersih.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">2</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Aplikasi</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            <strong>Kabut balik daun</strong> & kocor ringan bibir pot pagi hari.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">3</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Interval</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Ulangi rutin <strong>tiap 5–7 hari</strong> sampai akar gondrong.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS & OVERCLAIM SHOWCASE GALLERY -->
    <section class="bg-slate-50/60 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Bukti Kolektor: <span class="hl-brush">Koleksi Jutaan Batal Mati</span>
      </h2>

      <div class="mt-5 space-y-5">
        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/testi-1.webp"
            alt="Ibu Rini di teras rumah Bogor memegang pot Aglonema Suksom dan Khanza merah segar bertunas banyak sehabis pulih dengan SARATOGA"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Ibu Rini Wulandari, Bogor</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Pecah 3 Caling Baru</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Aglonema Khanza & Suksom nyaris habis gara-gara sekam mentah asam, akar sisa 3 helai. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Direndam & kabut SARATOGA 2 minggu, akar putih langsung gondrong dan pecah 3 mata caling!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/testi-2.webp"
            alt="Mas Hendra di Bandung bersama Monstera Albo Variegata yang kembali segar tegap berdaun robek putih bersih"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Mas Hendra Wijaya, Bandung</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Albo Jutaan Selamat</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Monstera Albo stres berat habis pindah pot & salah pupuk sampai daun merunduk kisut. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Dikabut SARATOGA tiap 5 hari tanpa bau amis, akar putih langsung nembus media & daun baru mulus!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/testi-3.webp"
            alt="Ibu Maya di Malang memegang Anggrek Bulan berbunga lebat berakar hijau sehat dan Anthurium segar"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Ibu Maya Kusuma, Malang</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Akar Hijau & Mekar</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Anggrek Bulan & Anthurium sempat busuk akar karena keseringan disiram. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Sejak rutin semprot SARATOGA, ujung akar hijau segar tumbuh aktif dan keluar 2 tangkai bunga!</strong>"
            </p>
          </div>
        </div>
      </div>

      <!-- Fullwidth Overclaim Panorama -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/hamparan-hias.webp"
          alt="Teras rumah tropis Indonesia penuh koleksi tanaman hias mewah Aglonema Monstera Anthurium dan Anggrek yang subur mengilap"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-950 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Cocok untuk Aglonema, Monstera, Philodendron, Anthurium, Alocasia & Anggrek di seluruh Indonesia!
          </p>
        </div>
      </div>

      <!-- 2-Card Final Overclaim Showcase -->
      <div class="mt-5 grid grid-cols-2 items-stretch gap-3">
        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/trio-juara.webp"
            alt="Tiga tanaman hias juara: Aglonema Suksom merah tebal, Monstera fenestrasi sempurna, dan Anggrek Bulan berbunga segar"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Daun Tebal Mewah</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">Turgor kaku & pigmen menyala</p>
          </div>
        </div>

        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/penyelamat-tanaman-jutaan-salah-rawat/panen-2.webp"
            alt="Akar putih sehat anggrek dan rumpun anakan caling Aglonema merah tumbuh subur"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Akar & Caling Lebat</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">Bonggol sehat cepat beranak</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-12">
      <div class="px-5 pb-6 text-center">
        <span class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-[11px] font-bold text-emerald-900">
          Garansi Produk Asli {product.productName}
        </span>
        <h2 class="mx-auto mt-2 max-w-[340px] text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Penyelamat SARATOGA</span>
        </h2>
        <p class="mx-auto mt-2 max-w-[340px] text-[14px] text-slate-600">
          Pilih ukuran kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}) di bawah. Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        mode="hybrid"
        embedded={true}
      />
    </section>

    <!-- Floating Bottom CTA Bar (Auto-hides while checkout form is in view) -->
    <div
      id="lp-floating-bar"
      class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full max-w-[480px] items-center justify-between gap-3 border-t border-slate-200/90 bg-white/95 px-4 py-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom))] shadow-[0_-8px_24px_rgba(15,23,42,0.1)] backdrop-blur-md transition-all duration-300"
    >
      <div class="min-w-0">
        <p class="truncate text-[11px] font-semibold text-emerald-800">
          SARATOGA {cheapest?.label ?? '250ml'}–2L
        </p>
        <div class="mt-0.5 flex items-baseline gap-1.5">
          <span class="text-[11px] font-medium text-slate-500">Mulai</span>
          <span class="text-[18px] font-bold leading-none tracking-tight text-slate-950">
            {formatIdr(price)}
          </span>
          {
            comparePrice > price && (
              <span class="hidden min-[440px]:inline text-[12px] font-normal text-slate-400 line-through">
                {formatIdr(comparePrice)}
              </span>
            )
          }
        </div>
      </div>
      <a
        href="#checkout-form"
        class="inline-flex min-h-11 shrink-0 items-center justify-center gap-1.5 rounded-xl bg-[#15803d] px-5 text-[13px] font-bold text-white shadow-[0_4px_12px_rgba(21,128,61,0.28)] transition-colors hover:bg-[#166534] active:scale-[0.98]"
      >
        <span>Pesan Sekarang (COD)</span>
        <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </main>

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });

    function initLpFloatingBar() {
      const bar = document.getElementById('lp-floating-bar');
      const form = document.getElementById('checkout-form');
      if (!bar || !form || !('IntersectionObserver' in window)) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              bar.style.transform = 'translateY(100%)';
              bar.style.opacity = '0';
              bar.style.pointerEvents = 'none';
            } else {
              bar.style.transform = 'translateY(0)';
              bar.style.opacity = '1';
              bar.style.pointerEvents = 'auto';
            }
          });
        },
        { threshold: 0.05 }
      );
      observer.observe(form);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLpFloatingBar);
    } else {
      initLpFloatingBar();
    }
  </script>
</BaseLayout>
