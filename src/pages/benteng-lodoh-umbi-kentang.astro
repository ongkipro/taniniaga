---
/**
 * Native Landing Page: Perisai Kresek Daun Lodoh Pembesar Kentang: Kojien (KOJIEN)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: kojien (ID: 99118)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/benteng-lodoh-umbi-kentang.css';

export const prerender = false;

const SLUG = 'benteng-lodoh-umbi-kentang';

const product =
  (await getStorefrontProduct(Astro.locals, 'kojien')) ??
  (await getStorefrontProduct(Astro.locals, '99118'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/benteng-lodoh-umbi-kentang/hero-problem.webp';
---

<BaseLayout
  title={`Perisai Kresek Daun Lodoh Pembesar Kentang: Kojien - ${Astro.locals.tenant.name}`}
  description="Lindungi tanaman kentang dari serangan hawar daun lodoh Phytophthora di musim kabut dan hujan. Kojien tebalkan daun dan maksimalkan pengisian umbi Grade A."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">BENTENG KENTANG DARI BADAI KABUT LODOH!</span>
          Daun Kentang Hitam Lodoh Habis Kabut & Umbi Kerdil Dijamin <span class="hl-brush">TEGAK & UMBI JUMBO</span>!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup semprot <strong class="text-slate-950 font-bold">KOJIEN</strong>, bercak basah Phytophthora langsung kering, daun tebal berlapis Silika efek daun talas, 85% umbi masuk kelas Super A/AB!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan daun kentang lodoh busuk hitam Phytophthora vs daun tegak tebal dan umbi super dengan Kojien"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Hasil Nyata: Daun kentang tegak hijau gelap sampai 100 HST & stolon penuh umbi kuning Grade A!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Perisai Kabut Silika</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>85% Umbi Grade A/AB</span>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Ancaman Fatal <span class="hl-brush-red">Petani Kentang Dataran Tinggi</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Begitu daun habis terserang lodoh di umur 55 HST, pembesaran umbi berhenti total:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/benteng-lodoh-umbi-kentang/gejala-1.webp"
              alt="Bercak basah hitam lodoh Phytophthora infestans dengan tepung putih di tepi daun kentang"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Hawar Daun Lodoh (Phytophthora)
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Bercak Hitam Basah Menyebar dalam 3 Hari</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Air kabut yang menggenang di daun tipis menjadi pintu masuk spora jamur Phytophthora infestans yang menghanguskan kebun.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/benteng-lodoh-umbi-kentang/gejala-2.webp"
              alt="Batang tanaman kentang busuk basah hitam rebah dan umbi kentang kecil kerdil"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Batang Rebah & Umbi Rincik (Kecil)
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Batang Busuk Berlendir & Umbi Gagal Mengisi</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Kiriman pati dari daun ke stolon terputus sehingga saat dibongkar mayoritas umbi berukuran kecil (TO) dan mudah busuk.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON (Full Visual Overclaim) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Daun Lodoh</span> Jadi <span class="hl-brush">Umbi Super A/AB</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/benteng-lodoh-umbi-kentang/overclaim-timeline.webp"
          alt="Tahapan perlindungan daun kentang dari bercak lodoh hingga panen umbi kentang Grade A dengan Kojien"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">30 HST: Daun Tebal</span>
          <span class="text-amber-300">60 HST: Stolon Penuh</span>
          <span class="text-emerald-400">95+ HST: Umbi Super</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/benteng-lodoh-umbi-kentang/kondisi-rusak.webp"
            alt="Lahan kentang tanpa Kojien daun hangus lodoh dan umbi kecil busuk"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa KOJIEN
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Ludes Lodoh & Kecil</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Daun meleleh hitam habis kabut, panen dini umbi kerdil.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/benteng-lodoh-umbi-kentang/kondisi-pulih.webp"
            alt="Lahan kentang dengan Kojien daun hijau tebal tegak di kabut dan umbi kuning besar"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai KOJIEN
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Tegak & Umbi Jumbo</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Daun hijau utuh sampai 100 HST, umbi besar kulit kuning mulus.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/benteng-lodoh-umbi-kentang/kojien-hero.webp"
          alt="Botol resmi Kojien berhologram asli untuk pelindung daun kentang dan pembesar umbi"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi KOJIEN Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">KOJIEN Original, Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Bio-Silika Efek Daun Talas + Kalium Pengisi Pati Umbi (500ml & 1L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Benteng Kentang KOJIEN</span> di Dataran Tinggi
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Melindungi daun dari kabut ekstrem sekaligus memompa karbohidrat ke umbi:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/benteng-lodoh-umbi-kentang/overclaim-1.webp"
              alt="Daun kentang tebal tegak berlapis silika dengan butiran air embun menggelinding"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • DAUN TEBAL EFEK TALAS
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Air Kabut Menggelinding Jatuh, Jamur Gagal Menempel!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Lapisan Silika membuat daun kentang kaku tegak dan berlilin tebal sehingga spora Phytophthora tidak mampu menembus jaringan.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/benteng-lodoh-umbi-kentang/overclaim-2.webp"
              alt="Rumpun akar stolon kentang yang dicabut penuh dengan 12 umbi kentang kuning besar"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • POMPA PATI KE STOLON
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                1 Rumpun Isi 10–14 Umbi Besar Seragam Kelas A/AB!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Kalium ionik mempercepat pengiriman fotosintat dari daun ke umbi sehingga bobot umbi padat dan minim sortiran kecil.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/benteng-lodoh-umbi-kentang/overclaim-3.webp"
              alt="Umbi kentang Granola Grade A berkulit kuning mulus tebal dan padat berisi"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • KULIT UMBI TEBAL MULUS
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Bebas Hati Kosong (Hollow Heart) & Tahan Simpan!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Memperkuat kulit umbi Granola maupun Atlantik agar kuning bersih, tidak mudah lecet, dan tahan simpan di gudang.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/benteng-lodoh-umbi-kentang/macro-proof.webp"
          alt="Detail batang dan daun kentang yang kokoh berdampingan dengan umbi kentang super"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Irit Fungisida Mahal: Hemat biaya semprot fungisida kontak Rp4–6 juta per hektar!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis</span>
      </h2>

      <div class="-mx-5 my-4">
        <img
          src="/images/landing/benteng-lodoh-umbi-kentang/aplikasi-kebun.webp"
          alt="Petani kentang dataran tinggi menyemprotkan Kojien di bedengan kentang berkabut"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 items-stretch gap-2.5 text-center">
        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">1</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Takaran</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Umur 20–45 HST: <strong>30 ml KOJIEN</strong>/tangki 16L tiap 7 hari.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">2</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Aplikasi</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Umur 50–85 HST: <strong>40 ml KOJIEN</strong>/tangki tiap 5–7 hari.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">3</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Interval</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Kocor guludan <strong>4 ml/liter</strong> saat bumbun (35 HST).
          </p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS & OVERCLAIM HARVEST GALLERY -->
    <section class="bg-slate-50/60 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Bukti Lapangan: <span class="hl-brush">Lolos Kabut & Panen Super</span>
      </h2>

      <div class="mt-5 space-y-5">
        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/benteng-lodoh-umbi-kentang/testi-1.webp"
            alt="Pak H. Muhtarom di Batur Dieng menunjukkan umbi kentang Granola berukuran besar"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak H. Muhtarom, Dieng, Jateng</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Utuh Sampai 100 HST</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Kabut tebal seminggu bikin lahan sekitar lodoh di 60 HST. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Kebun saya yang rutin KOJIEN daunnya kaku tebal dan panen penuh di 100 HST!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/benteng-lodoh-umbi-kentang/testi-2.webp"
            alt="Pak Asep Ruhiyat di Pangalengan Bandung di samping karung jaring panen kentang"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Asep Ruhiyat, Pangalengan, Jabar</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">85% Masuk Grade AB</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Satu pohon rata-rata isi 12 umbi besar seragam. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Kulitnya kuning bersih dan 85% masuk kelas AB Super!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/benteng-lodoh-umbi-kentang/testi-3.webp"
            alt="Pak Kariyono di Tosari Bromo memegang rumpun kentang penuh umbi padat"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Kariyono, Tosari Bromo, Jatim</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Tembus 27 Ton/Ha</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Biaya fungisida hemat separuh dan <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">hasil bongkar umbi tembus 27 ton per hektar padat berisi!</strong>"
            </p>
          </div>
        </div>
      </div>

      <!-- Fullwidth Overclaim Panorama -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/benteng-lodoh-umbi-kentang/hamparan-kebun.webp"
          alt="Hamparan kebun kentang terasering di dataran tinggi Dieng yang hijau subur bebas lodoh"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-950 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Andalan Dieng, Bromo, Pangalengan & Kerinci: Daun tegak tahan kabut, umbi melimpah!
          </p>
        </div>
      </div>

      <!-- 2-Card Final Overclaim Showcase -->
      <div class="mt-5 grid grid-cols-2 items-stretch gap-3">
        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/benteng-lodoh-umbi-kentang/panen-rekor.webp"
            alt="Deretan karung jaring penuh panen umbi kentang Granola kuning besar saat panen raya"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Dominan Kelas Super</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">85%+ masuk ukuran Grade A/AB</p>
          </div>
        </div>

        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/benteng-lodoh-umbi-kentang/panen-2.webp"
            alt="Tumpukan umbi kentang Grade A baru dipanen dengan kulit kuning bersih mulus"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Kulit Kuning Mulus</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">Padat berbobot & tahan gudang</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-12">
      <div class="px-5 pb-6 text-center">
        <span class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-[11px] font-bold text-emerald-900">
          Garansi Produk Asli {product.productName}
        </span>
        <h2 class="mx-auto mt-2 max-w-[340px] text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Benteng Kentang</span>
        </h2>
        <p class="mx-auto mt-2 max-w-[340px] text-[14px] text-slate-600">
          Pilih ukuran kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}) di bawah. Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        selectedVariantId={cheapest?.id}
        mode="hybrid"
        embedded={true}
      />
    </section>
  </main>

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
