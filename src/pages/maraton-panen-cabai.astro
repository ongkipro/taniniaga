---
/**
 * Native Landing Page: LP-10 Maraton Panen 25-30 Kali Petikan Tanpa Afkir (BENSU)
 *
 * Visual Pattern: Inspired by AdsBook Direct Response Architecture
 * Master Product: bensu-pupuk-cair-organik
 * Kontrak Arsitektur: docs/LANDING-PAGES.md & docs/spec/10-BRUTAL-OVERCLAIM-LANDING-PAGES-CATALOG.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/maraton-panen-cabai.css';

export const prerender = false;

const SLUG = 'maraton-panen-cabai';

const product = await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik');
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/maraton-panen-cabai/hero-maraton.webp';
---

<BaseLayout
  title={`Rahasia Panen Maraton Cabai Tembus 25 Kali Petikan Tanpa Afkir | ${Astro.locals.tenant.name}`}
  description="Picu cabang baru dan buah bertingkat lebat terus mengalir tembus 25-30 kali petikan. Jangan bongkar bedengan saat harga cabai di pasaran mahal!"
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={false}
>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector=""
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <!-- 1. HERO SECTION (High-Impact Mobile First-Fold / Stop Scrolling Hook) -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-8">
        <h1 class="mx-auto max-w-[440px] text-[clamp(28px,7.8vw,34px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight">JANGAN DIBONGKAR DULU!</span>
          Rahasia Panen Cabai Maraton Tembus <span class="hl-brush">25–30 KALI PETIKAN</span> Tanpa Afkir
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[15.5px] font-medium leading-relaxed text-slate-700">
          Saat kebun lain sudah kuning loyo di petikan ke-8, pohon cabai Anda terus meletus tunas dan buah lebat saat harga cabai sedang mahal-mahalnya!
        </p>
      </div>

      <div class="mt-6">
        <!-- Hero Image: Fullwidth Edge-to-Edge with Proof Banner Overlay -->
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi pohon cabai berbuah lebat bertingkat 3 lantai masih panen raya di petikan ke-25 sehabis aplikasi BENSU"
            class="h-full w-full object-cover"
            width="1376"
            height="768"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/80 px-4 py-2.5 text-center backdrop-blur-sm">
            <p class="text-[12.5px] font-bold text-[#BBF7D0]">
              Pohon tetap rimbun 3 tingkat, buah mengalir lebat sampai petikan ke-25!
            </p>
          </div>
        </div>

        <!-- Trust Points Row -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 px-4 text-[12px] font-semibold text-slate-700">
          <span>Formula Re-Start Seluler</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Garansi Buah Bertingkat</span>
        </div>

        <!-- Takeaway Box with left accent border -->
        <div class="mt-5 mx-5 text-left border-l-2 border-emerald-600 pl-4 bg-emerald-50/40 py-2.5 pr-3 rounded-r">
          <p class="text-[14.5px] font-bold text-slate-950">Membongkar bedengan cabai di petikan ke-8 adalah kerugian besar.</p>
          <p class="text-[13px] leading-relaxed text-slate-600 mt-1">
            Pohon loyo bukan karena umur tanaman habis, melainkan kehabisan asam amino pembentuk tunas baru. Re-start sel tanaman dengan nutrisi dingin pasca petik agar cabang baru meletus dan buah terus mengalir.
          </p>
        </div>
      </div>
    </section>

    <!-- 2. HARD PROBLEM SECTION (Fakta Lapangan Pohon Cabai Cepat Afkir) -->
    <section class="bg-red-50/30 px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Kenapa Kebun Cabai Petani Sering <span class="hl-brush-red">Cepat Loyo & Afkir</span>?
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Masuk petikan ke-7 atau ke-8 biasanya kebun mulai menguning, daun berguguran, dan buah menyusut kecil-kecil:
      </p>

      <div class="space-y-4">
        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">1. Kehabisan Pasokan Asam Amino Tunas</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Tanaman diperas nutrisinya untuk mematangkan buah tanpa diberi asupan pemulih sel yang cepat serap, memicu penuaan dini sel tanaman.</p>
        </div>

        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">2. Cabang Atas Mandul & Daun Botak</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Ketiak daun tidak mampu lagi mengeluarkan mata tunas baru. Ranting atas kurus mengering, bunga rontok, dan buah susulan berhenti tumbuh.</p>
        </div>

        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">3. Terpaksa Bongkar Saat Harga Cabai Meroket</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Petani gigit jari terpaksa mencabut pohon dan keluar biaya puluhan juta untuk olah tanah dan bibit baru, padahal harga cabai di pasaran sedang melambung tinggi!</p>
        </div>
      </div>
    </section>

    <!-- 3. PHYSICAL COMPARISON SECTION (Perbandingan Fisik Lapangan) -->
    <section class="bg-white px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Bedanya Nyata: <span class="hl-brush-red">Loyo Afkir</span> vs <span class="hl-brush">Panen Maraton</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Tanpa nutrisi pemulih, pohon cabai berhenti berbuah di petikan ke-8. Tapi dengan re-start seluler, buah terus berlipat ganda:
      </p>

      <div class="grid grid-cols-2 gap-3.5">
        <!-- Card Bad (Kondisi Afkir) -->
        <div class="relative overflow-hidden bg-slate-50/60 rounded-lg border border-slate-100 shadow-sm">
          <img
            src="/images/landing/maraton-panen-cabai/kondisi-afkir.webp"
            alt="Kondisi pohon cabai loyo afkir daun kuning di petikan ke-8"
            class="aspect-[3/2] w-full object-cover"
            width="480"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm">
            Petikan ke-8
          </div>
          <div class="p-3">
            <h3 class="text-[13px] font-bold text-slate-900">Loyo & Daun Botak</h3>
            <p class="text-[11.5px] text-slate-500 mt-0.5 leading-relaxed">
              Pohon kurus menguning, cabang mandul buah, terancam dibongkar rugi besar.
            </p>
          </div>
        </div>

        <!-- Card Good (Hasil Maraton) -->
        <div class="relative overflow-hidden bg-slate-50/60 rounded-lg border border-slate-100 shadow-sm">
          <img
            src="/images/landing/maraton-panen-cabai/kondisi-maraton.webp"
            alt="Kondisi pohon cabai berbuah rimbun lebat bertingkat tembus 25 kali petikan"
            class="aspect-[3/2] w-full object-cover"
            width="480"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm">
            Petikan ke-25
          </div>
          <div class="p-3">
            <h3 class="text-[13px] font-bold text-emerald-800">Panen Terus Mengalir</h3>
            <p class="text-[11.5px] text-slate-600 mt-0.5 leading-relaxed">
              Cabang baru meletus 3 tingkat, buah merah padat berbobot mengalir sampai akhir tahun.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT SPECIFICATION & KNOWLEDGE (Solusi Produk BENSU Re-Start Seluler) -->
    <section class="bg-white px-5 py-10">
      <!-- Fullwidth Product Banner -->
      <div class="-mx-5 mb-8">
        <img
          src="/images/landing/maraton-panen-cabai/produk-hero.webp"
          alt="Botol Pupuk Organik Cair BENSU di Kebun Cabai Panen Raya"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
      </div>

      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        BENSU — Re-Start Pertumbuhan <span class="hl-brush">Panen Maraton</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        BENSU memberikan dorongan energi instan pasca panen petikan. Bekerja langsung memicu diferensiasi titik tumbuh tunas baru 24 jam sehabis buah dipetik, memadatkan klorofil daun tua agar tetap hijau segar, dan mengunci bunga susulan menjadi buah berbobot tanpa jeda dormansi.
      </p>

      <div class="mt-8 space-y-5">
        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Cabang Produktif Bertingkat 3 Lantai</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Setiap ketiak daun terus meletus cabang produktif baru, membentuk tajuk pohon yang rimbun bertingkat dengan bunga baru serempak.
          </p>
        </div>

        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Buah Tetap Panjang & Berbobot Hingga Akhir</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Ukuran dan bobot buah di petikan ke-20 sama montok dan padatnya dengan petikan awal, diterima pedagang dengan harga penawaran tertinggi.
          </p>
        </div>

        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Meraup Untung Saat Harga Cabai Meroket</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Panen terus mengalir berminggu-minggu saat kebun tetangga sudah habis dibongkar dan harga cabai di pasar induk melonjak tinggi.
          </p>
        </div>
      </div>

      <!-- Macro Shoot Explosion Photo Banner (Fullwidth Edge-to-Edge) -->
      <div class="-mx-5 mt-8 relative">
        <img
          src="/images/landing/maraton-panen-cabai/cabang-bertingkat.webp"
          alt="Foto makro cabang produktif baru mekar dari ketiak ranting pohon cabai yang sedang berbuah"
          class="aspect-[16/9] w-full object-cover"
          width="1200"
          height="896"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900/90 py-2.5 px-4 text-center">
          <p class="text-[12px] font-bold text-[#BBF7D0]">
            Hasil Nyata: Cabang baru terus meletus lebat di atas ranting yang baru saja selesai dipetik.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. HOW IT WORKS / CARA APLIKASI LAHAN -->
    <section class="bg-emerald-50/20 px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Sederhana & <span class="hl-brush">Cepat Dipraktekkan</span> di Kebun
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Nggak perlu cara ribet. Cukup semprot kabut setiap selesai petik buah:
      </p>

      <!-- Fullwidth Photo: Petani Aplikasi Semprot di Kebun -->
      <div class="-mx-5 mb-8 mt-2">
        <img
          src="/images/landing/maraton-panen-cabai/kocor-pasca-petik.webp"
          alt="Petani menyemprot dan mengocor nutrisi pemulih sehabis petik buah cabai di lahan"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Vertical Timeline Cards -->
      <div class="relative border-l-2 border-emerald-100/80 pl-7 space-y-4 ml-2 mt-6">
        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            1
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Aplikasi 1 Hari Pasca Petik</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Sehari setelah petik cabai merah selesai, campurkan 2-3 tutup botol BENSU ke dalam 1 tangki semprot (16 liter air).
          </p>
        </div>

        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            2
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Semprot Kabut Pagi Hari</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Semprotkan kabut halus ke tajuk daun atas dan ketiak cabang untuk memicu tunas baru dan menguatkan daun tua agar tidak gugur.
          </p>
        </div>

        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            3
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Panen Terus Mengalir</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Pohon tetap hijau royo-royo, bunga baru terus keluar bersusulan, dan masa petikan tembus 25 hingga 30 kali tanpa afkir!
          </p>
        </div>
      </div>
    </section>

    <!-- 6. TESTIMONIALS SECTION (Hasil Nyata di Kebun Petani) -->
    <section class="bg-white px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Kisah Nyata Petani: <span class="hl-brush">Panen Terus Mengalir</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-8">
        Lebih dari 1.500 petani cabai membuktikan sendiri panennya tembus 25–30 kali petikan:
      </p>

      <div class="space-y-8">
        <!-- Testimoni 1: Pak Edi Susanto -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Edi Susanto (42 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Harapan Makmur, Desa Gadungan, Puncu, Kediri</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Cabai Rawit Ori 212 • Tembus 25 Kali Petikan</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/maraton-panen-cabai/testi-edi.webp"
              alt="Dokumentasi tanaman cabai rawit Pak Edi Susanto panen tembus 25 kali di Kediri"
              class="h-full w-full object-cover"
              width="1376"
              height="768"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Cabai Rawit Ori 212 populasi 3.200 pohon. Biasanya petikan ke-8 pohon sudah menguning dan buah mengecil. Rutin kocor dan semprot BENSU 25 ml per tangki tiap selesai petik. <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">Tanaman cabai saya tembus petikan ke-25!</strong> Buahnya tetap panjang mengkilap dan berbobot padat. <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">Sangat untung saat harga cabai tembus Rp 65.000/kg</strong>."
          </p>

          <div class="pt-4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
        </div>

        <!-- Testimoni 2: Pak Syarifuddin -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Syarifuddin (46 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Gunung Hijau, Desa Taring, Biringbulu, Gowa</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Cabai Rawit Asmoro • Petikan Tembus 28 Kali</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/maraton-panen-cabai/testi-syarifuddin.webp"
              alt="Dokumentasi tanaman cabai rawit Pak Syarifuddin bertingkat rimbun di Gowa Sulsel"
              class="h-full w-full object-cover"
              width="1376"
              height="768"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Cabai rawit Asmoro petikan tembus 28 kali tanpa henti. <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">Pohon tetap rimbun 3 tingkat dan tidak ada pohon yang afkir</strong>. Tetangga kebun heran cabai saya gak habis-habis buahnya."
          </p>

          <div class="pt-4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
        </div>

        <!-- Testimoni 3: Pak Agus Salim -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Agus Salim (40 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Tunas Karya, Desa Kertawangi, Cisarua, Bandung Barat</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Cabai Merah Tanjung • Berbuah Hingga Bulan ke-8</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/maraton-panen-cabai/testi-agus.webp"
              alt="Dokumentasi tanaman cabai merah Pak Agus Salim berbuah terus menerus di Bandung Barat"
              class="h-full w-full object-cover"
              width="1376"
              height="768"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Cabai Merah Tanjung berbuah lebat terus menerus hingga bulan ke-8. <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">Tidak perlu keluar modal bongkar bedengan dini</strong>, hasilnya sangat memuaskan."
          </p>
        </div>
      </div>

      <!-- Panorama Hamparan Kebun Pulih (Fullwidth Edge-to-Edge) -->
      <div class="-mx-5 mt-10 relative">
        <img
          src="/images/landing/maraton-panen-cabai/kebun-maraton.webp"
          alt="Foto panorama hamparan kebun cabai rimbun hijau subur masih panen raya di perbukitan"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900/90 py-2.5 px-4 text-center">
          <p class="text-[12px] font-bold text-[#BBF7D0]">
            Kebun Maraton: Pohon tetap hijau produktif dan panen mengalir lebat hingga puluhan kali petikan.
          </p>
        </div>
      </div>

      <!-- Inset Card Bukti Panen Rekor -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-100 bg-slate-50/50 shadow-sm">
        <img
          src="/images/landing/maraton-panen-cabai/panen-rekor.webp"
          alt="Foto pohon cabai panen lebat berderot dari dahan bawah hingga dahan atas"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
        <div class="p-3 text-center">
          <p class="text-[13px] font-semibold text-slate-800">
            Hasil Akhir: Bobot buah padat berkualitas super dan terus berbuah sampai akhir musim.
          </p>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-12">
      <div class="px-5 pb-6 text-center">
        <h2 class="mx-auto max-w-[340px] text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Panen Maraton</span>
        </h2>
        <p class="mx-auto mt-2 max-w-[340px] text-[14px] text-slate-600">
          Isi alamat pengiriman di bawah untuk menerima paket langsung di rumah.
        </p>
      </div>

      <GeoIpResolvedForm productSlug={product.slug} mode="hybrid" embedded={true} />
    </section>
  </main>

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
