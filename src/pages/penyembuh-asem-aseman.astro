---
/**
 * Native Landing Page: Penyembuh Asem-Aseman Padi (BENSU)
 *
 * Visual Pattern: Inspired by bangkitkan-tanaman-mandek
 * Master Product: bensu-pupuk-cair-organik
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/penyembuh-asem-aseman.css';

export const prerender = false;

const SLUG = 'penyembuh-asem-aseman';

const product =
  (await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '21329')) ??
  (await getStorefrontProduct(Astro.locals, 'bensu-taniniaga')) ??
  (await getStorefrontProduct(Astro.locals, '44363'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/penyembuh-asem-aseman/hero-problem.webp';
---

<BaseLayout
  title={`Obat Padi Asem-Aseman: 4 Hari Daun Merah Karat Jadi Hijau Royo & 40+ Anakan | ${Astro.locals.tenant.name}`}
  description="Solusi darurat padi sawah kerdil asem-aseman akibat tanah masam dan jerami belum matang. Cuci asam seketika, akar putih gondrong, anakan meledak 40+ batang."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={false}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <!-- 1. HERO SECTION (High-Impact Mobile First-Fold / Stop Scrolling Hook) -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-8">
        <h1 class="mx-auto max-w-[440px] text-[clamp(28px,7.8vw,34px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight">JANGAN DIBIARKAN MENGUNING KARAT!</span>
          Padi Asem-Aseman Dijamin <span class="hl-brush">HIJAU ROYO-ROYO</span> & Meledak 40+ Anakan
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[15.5px] font-medium leading-relaxed text-slate-700">
          Cukup semprot kabut <strong class="text-slate-950 font-bold">BENSU</strong>, racun asam tanah netral seketika, akar putih gondrong, anakan produktif melimpah tanpa buang modal NPK!
        </p>
      </div>

      <div class="mt-6">
        <!-- Hero Image: Fullwidth Edge-to-Edge with Proof Banner Overlay -->
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi padi asem-aseman daun merah karat vs pulih hijau royo-royo sehabis semprot BENSU"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/80 px-4 py-2.5 text-center backdrop-blur-sm">
            <p class="text-[12.5px] font-bold text-[#BBF7D0]">
              Hasil 4 Hari: Daun merah karat pulih hijau pekat, anakan produktif meledak 40+ batang!
            </p>
          </div>
        </div>

        <!-- Trust Points Row -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 px-4 text-[12px] font-semibold text-slate-700">
          <span>100% Organik Dingin</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Garansi Pulih 4 Hari</span>
        </div>

        <!-- Takeaway Box with left accent border -->
        <div class="mt-5 mx-5 text-left border-l-2 border-emerald-600 pl-4 bg-emerald-50/40 py-2.5 pr-3 rounded-r">
          <p class="text-[14.5px] font-bold text-slate-950">Padi asem-aseman jangan malah dihantam Urea atau pupuk kimia pekat!</p>
          <p class="text-[13px] leading-relaxed text-slate-600 mt-1">
            Akar serap yang keracunan asam tanah dan pirit besi sedang lemas dan menghitam. Semprot kabut nutrisi dingin BENSU lewat daun agar sel padi bangun seketika dan anakan produktif langsung mekar serempak.
          </p>
        </div>
      </div>
    </section>

    <!-- 2. HARD PROBLEM SECTION (Fakta Lapangan Padi Asem-Aseman) -->
    <section class="bg-red-50/30 px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Kenapa Padi Bisa <span class="hl-brush-red">Asem-Aseman</span> & Macet Anakan?
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Banyak petani panik melihat daun padi merah menguning kerdil di umur 10-25 HST, lalu mengira kurang pupuk dan nekat tabur Urea/NPK. Akibatnya malah fatal:
      </p>

      <div class="space-y-4">
        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">1. Pembusukan Jerami Mentah di Lumpur</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Sisa jerami yang belum matang menghasilkan asam-asam organik pekat dan gas beracun di bawah lumpur sawah. pH tanah anjlok drastis sehingga membakar bulu akar serap.</p>
        </div>

        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">2. Keracunan Pirit & Besi (Fe) Masam</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Air sawah tergenang asam membuat ion besi terlarut bebas. Daun padi berkarat merah kecokelatan, batang kerdil kaku, dan mulut stomata mengunci rapat.</p>
        </div>

        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">3. Salah Kasih Pupuk Kimia Keras</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Petani panik lalu menabur Urea atau NPK saat akar sedang keracunan asam. Hasilnya akar serap makin gosong membusuk hitam dan anakan padi macet cuma mentok 7-10 batang!</p>
        </div>
      </div>
    </section>

    <!-- 3. PHYSICAL COMPARISON SECTION (Perbandingan Fisik Lapangan) -->
    <section class="bg-white px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Bedanya Nyata: <span class="hl-brush-red">Asem-Aseman</span> vs <span class="hl-brush">Anakan Meledak</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Padi yang dibiarkan asem-aseman akan kerdil, pucuk melintir, dan anakan mati suri. Tapi begitu racun dicuci dengan BENSU, perubahan fisiknya nyata di sawah:
      </p>

      <div class="grid grid-cols-2 gap-3.5">
        <!-- Card Bad (Kondisi Asem-Aseman) -->
        <div class="relative overflow-hidden bg-slate-50/60 rounded-lg border border-slate-100 shadow-sm">
          <img
            src="/images/landing/penyembuh-asem-aseman/kondisi-rusak.webp"
            alt="Kondisi padi sawah asem-aseman daun merah karat dan kerdil"
            class="aspect-[3/2] w-full object-cover"
            width="480"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm">
            Kondisi Asem-Aseman
          </div>
          <div class="p-3">
            <h3 class="text-[13px] font-bold text-slate-900">Daun Karat & Kerdil</h3>
            <p class="text-[11.5px] text-slate-500 mt-0.5 leading-relaxed">
              Akar hitam lemas di lumpur, pucuk kaku menguning, anakan macet terancam fuso.
            </p>
          </div>
        </div>

        <!-- Card Good (Hasil 4 Hari BENSU) -->
        <div class="relative overflow-hidden bg-slate-50/60 rounded-lg border border-slate-100 shadow-sm">
          <img
            src="/images/landing/penyembuh-asem-aseman/kondisi-pulih.webp"
            alt="Kondisi padi sawah pulih subur anakan lebat sehabis semprot Bensu"
            class="aspect-[3/2] w-full object-cover"
            width="480"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm">
            Hasil 4 Hari BENSU
          </div>
          <div class="p-3">
            <h3 class="text-[13px] font-bold text-emerald-800">Hijau Royo & 40+ Anakan</h3>
            <p class="text-[11.5px] text-slate-600 mt-0.5 leading-relaxed">
              Daun jegrik hijau pekat, akar serabut putih gondrong, anakan rapat produktif.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. PRODUCT SPECIFICATION & KNOWLEDGE (Solusi Produk BENSU) -->
    <section class="bg-white px-5 py-10">
      <!-- Fullwidth Product Banner -->
      <div class="-mx-5 mb-8">
        <img
          src="/images/landing/penyembuh-asem-aseman/bensu-hero.webp"
          alt="Botol Pupuk Organik Cair BENSU di Lahan Persawahan Subur Hijau"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        BENSU — Nutrisi Dingin <span class="hl-brush">Pencuci Asam Tanah</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        BENSU diramu khusus dari formula bioaktif dingin berenergi tinggi: asam amino bebas L-isomer, glisin betain peredam stres, dan asam humat organik. Bukan pupuk kimia panas yang memperparah pembusukan akar, melainkan nutrisi dingin instan yang langsung diserap daun tanpa bikin tanaman kerja berat.
      </p>

      <div class="mt-8 space-y-5">
        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Menetralisir Racun Asam & Besi Pirit</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Kandungan humat bioaktifnya mengikat senyawa pirit beracun di zona lumpur akar, mengembalikan keseimbangan pH ke level subur seketika.
          </p>
        </div>

        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Langsung Diserap Lewat Daun</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Asam amino L-isomer langsung menembus jaringan stomata daun dalam 2 jam, memberikan energi instan tanpa menunggu akar yang sedang lemas.
          </p>
        </div>

        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Memicu Ledakan Akar Putih & 40+ Anakan</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Merangsang titik tumbuh basal di pangkal rumpun, menumbuhkan akar serabut putih baru dan melipatgandakan anakan produktif serempak.
          </p>
        </div>
      </div>

      <!-- Macro Shoot Explosion Photo Banner (Fullwidth Edge-to-Edge) -->
      <div class="-mx-5 mt-8 relative">
        <img
          src="/images/landing/penyembuh-asem-aseman/akar-putih-gondrong.webp"
          alt="Foto makro akar serabut putih gondrong padi sawah sehabis semprot BENSU"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900/90 py-2.5 px-4 text-center">
          <p class="text-[12px] font-bold text-[#BBF7D0]">
            Hasil 4 Hari: Akar serabut putih baru gondrong menembus lumpur, rumpun mekar 40+ anakan kokoh.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. HOW IT WORKS / CARA APLIKASI LAHAN -->
    <section class="bg-emerald-50/20 px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Sederhana & <span class="hl-brush">Cepat Dipraktekkan</span> di Sawah
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Nggak perlu alat ribet atau biaya mahal. Cukup semprot kabut tipis di pagi hari saat stomata daun membuka sempurna:
      </p>

      <!-- Fullwidth Photo: Petani Aplikasi Semprot di Sawah -->
      <div class="-mx-5 mb-8 mt-2">
        <img
          src="/images/landing/penyembuh-asem-aseman/semprot-sawah.webp"
          alt="Petani menyemprot kabut nutrisi dingin BENSU di pematang sawah pagi hari"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Vertical Timeline Cards -->
      <div class="relative border-l-2 border-emerald-100/80 pl-7 space-y-4 ml-2 mt-6">
        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            1
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Takaran Hemat</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Campurkan 2-3 tutup botol BENSU (30-40 ml) ke dalam 1 tangki semprot (16 liter air bersih).
          </p>
        </div>

        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            2
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Semprot Kabut Pagi Hari</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Semprotkan kabut halus ke daun padi merata saat pagi (pukul 06.00 - 09.00) saat stomata daun sedang membuka sempurna.
          </p>
        </div>

        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            3
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Ulangi Selang 4-5 Hari</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Cukup 2 kali aplikasi, daun padi yang tadinya merah karat asem-aseman langsung pulih hijau royo-royo dan anakan baru berderet meletus serentak!
          </p>
        </div>
      </div>
    </section>

    <!-- 7. TESTIMONIALS SECTION (Hasil Nyata di Sawah Petani) -->
    <section class="bg-white px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Kisah Nyata Petani: <span class="hl-brush">Sawah Selamat & Panen Rekor</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-8">
        Ratusan kelompok tani di sentra lumbung padi membuktikan sendiri sawahnya bangkit dari asem-aseman tanpa perlu bongkar atau bajak ulang:
      </p>

      <div class="space-y-8">
        <!-- Testimoni 1: Pak Darsono -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Darsono (52 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Sumber Rejeki, Desa Sidoharjo, Sragen, Jawa Tengah</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Padi Inpari 32 • Asem-Aseman Rendeng Pasca Banjir</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/penyembuh-asem-aseman/testi-1.webp"
              alt="Dokumentasi tanaman padi Pak Darsono pulih dan beranak lebat di Sragen"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Umur 18 HST padi saya merah menguning semua kayak kebakar, lumpur bawahnya bau busuk menyengat. <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 text-slate-950 font-semibold">Mau saya bajak ulang sayang modal bibit</strong>. Begitu disemprot BENSU 2 kali selang 4 hari, <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">hari ke-5 daunnya langsung jegrik hijau royo-royo semua</strong>, akar serabut putihnya keluar gondrong. Anakan tembus 42 batang per rumpun!"
          </p>

          <div class="pt-4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
        </div>

        <!-- Testimoni 2: Pak H. Mansyur -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak H. Mansyur (49 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Tani Makmur, Desa Cilamaya, Subang, Jawa Barat</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Padi Ciherang • Tanah Masam Jerami Mentah</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/penyembuh-asem-aseman/testi-2.webp"
              alt="Dokumentasi tanaman padi Pak H. Mansyur daun hijau tegap dan beranak lebat di Subang"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Musim rendeng sawah saya langganan asem-aseman karena jerami belum matang sempurna sudah dibajak. <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 text-slate-950 font-semibold">Dikasih Urea malah daunnya makin gosong</strong>. Tahun ini saya semprot BENSU, daun merah karat langsung hilang bersih, <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">pertumbuhan tancap gas tanpa mandek</strong>. Tetangga sawah pada tanya rahasianya apa."
          </p>

          <div class="pt-4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
        </div>

        <!-- Testimoni 3: Pak Baharuddin -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Baharuddin (38 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Sipatuo, Rappang, Sidrap, Sulawesi Selatan</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Padi Mekongga • Anakan Macet Cuma 9 Batang</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/penyembuh-asem-aseman/testi-3.webp"
              alt="Dokumentasi tanaman padi Pak Baharuddin anakan produktif tembus rekor di Sidrap"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Padi umur 22 hari mandek kerdil, anakan cuma 8 sampai 9 batang kurus. Begitu pakai BENSU semprot kabut tipis di pagi hari, <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">anakan baru langsung meletus dari pangkal sampai 45 batang per rumpun!</strong> Hasil panen ubinan kemarin tembus rekor 8,7 ton per hektar."
          </p>
        </div>
      </div>

      <!-- Panorama Hamparan Sawah Pulih (Fullwidth Edge-to-Edge) -->
      <div class="-mx-5 mt-10 relative">
        <img
          src="/images/landing/penyembuh-asem-aseman/hamparan-sawah.webp"
          alt="Foto panorama hamparan sawah padi hijau subur membentang bebas asem-aseman"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900/90 py-2.5 px-4 text-center">
          <p class="text-[12px] font-bold text-[#BBF7D0]">
            Sawah Kembali Pulih: Hamparan padi hijau royo-royo membentang bebas asem-aseman, anakan rapat dan malai gabah padat bernas.
          </p>
        </div>
      </div>

      <!-- Inset Card Bukti Panen Rekor -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-100 bg-slate-50/50 shadow-sm">
        <img
          src="/images/landing/penyembuh-asem-aseman/panen-jumbo.webp"
          alt="Foto hasil panen padi kuning bernas melimpah"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="p-3 text-center">
          <p class="text-[13px] font-semibold text-slate-800">
            Hasil Akhir: Rumpun sehat dan anakan lebat menghasilkan malai gabah kuning bernas tanpa bulir hampa sampai pangkal.
          </p>
        </div>
      </div>
    </section>

    <!-- 8. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-12">
      <div class="px-5 pb-6 text-center">
        <h2 class="mx-auto max-w-[340px] text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Pemulih Padi</span>
        </h2>
        <p class="mx-auto mt-2 max-w-[340px] text-[14px] text-slate-600">
          Pilih ukuran kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}) di bawah. Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        mode="hybrid"
        embedded={true}
      />
    </section>
  </main>

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
