---
/**
 * Native Landing Page: LP-08 Rahasia Gabah Bernas Padi Sawah Sampai Pangkal (SARATOGA)
 *
 * Visual Pattern: Inspired by Saratoga Anthurium (petanisejahtera.com/saratoga-anthurium)
 * Master Product: saratoga-serum-tanaman-premium
 * Kontrak Arsitektur: docs/LANDING-PAGES.md & docs/spec/10-BRUTAL-OVERCLAIM-LANDING-PAGES-CATALOG.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/juara-gabah-bernas.css';

export const prerender = false;

const SLUG = 'juara-gabah-bernas';

const product = await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium');
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/juara-gabah-bernas/hero-gabah.webp';
---

<BaseLayout
  title={`Rahasia Gabah Bernas Padi Sawah Sampai Pangkal: Rekor 9 Ton/Ha | ${Astro.locals.tenant.name}`}
  description="Bikin bulir gabah bernas padat berbobot sampai pangkal malai. Daun bendera tetap hijau tegak mengawal pengisian susu gabah, bebas blast patah leher."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={false}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <!-- 1. HERO SECTION (High-Impact Mobile First-Fold / Stop Scrolling Hook) -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-8">
        <h1 class="mx-auto max-w-[440px] text-[clamp(28px,7.8vw,34px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight">JANGAN BIARKAN GABAH KOPONG!</span>
          Bulir Bernas Sampai Pangkal Malai: <span class="hl-brush">REKOR 9 TON/HA</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[15.5px] font-medium leading-relaxed text-slate-700">
          Daun bendera tetap hijau tegak 45° mengawal pengisian susu gabah hingga hari panen! Cukup semprot <strong class="text-slate-950 font-bold">SARATOGA</strong>, bebas blast patah leher, bulir kuning emas padat tanpa gabah melompong sampai pangkal!
        </p>
      </div>

      <div class="mt-6">
        <!-- Hero Image: Fullwidth Edge-to-Edge with Proof Banner Overlay -->
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi malai padi kuning keemasan bernas padat sampai pangkal sehabis semprot SARATOGA"
            class="h-full w-full object-cover"
            width="1376"
            height="768"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/80 px-4 py-2.5 text-center backdrop-blur-sm">
            <p class="text-[12.5px] font-bold text-[#BBF7D0]">
              Gabah Hampa &lt;3%: Bulir padat terisi sampai pangkal malai, timbangan naik 20%!
            </p>
          </div>
        </div>

        <!-- Trust Points Row -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 px-4 text-[12px] font-semibold text-slate-700">
          <span>Serum Pemadat Bulir Gabah</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Garansi Rekor Tonase</span>
        </div>

        <!-- Takeaway Box with left accent border -->
        <div class="mt-5 mx-5 text-left border-l-2 border-emerald-600 pl-4 bg-emerald-50/40 py-2.5 pr-3 rounded-r">
          <p class="text-[14.5px] font-bold text-slate-950">Jangan biarkan timbangan panen Anda anjlok karena gabah melompong hampa.</p>
          <p class="text-[13px] leading-relaxed text-slate-600 mt-1">
            Pengisian bulir optimal ditentukan oleh kesegaran daun bendera pada umur 65–85 HST. Pompa translokasi pati dengan asam amino generatif agar bulir terbawah terisi susu padat.
          </p>
        </div>
      </div>
    </section>

    <!-- 2. HARD PROBLEM SECTION (Fakta Lapangan Gabah Kopong) -->
    <section class="bg-red-50/30 px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Kenapa Bulir Gabah Bisa <span class="hl-brush-red">Banyak Kopong Hampa</span> di Pangkal?
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Banyak petani mengira gabah hampa hal biasa. Padahal saat bunting tua dan keluar malai, ada 3 penyebab utama yang memutus pengisian susu:
      </p>

      <div class="space-y-4">
        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">1. Daun Bendera Mengering Sebelum Waktunya</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Jamur hawar pelepah dan cuaca ekstrem bikin daun bendera mati prematur umur 70 HST. Pabrik energi fotosintesis tutup sebelum bulir terisi.</p>
        </div>

        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">2. Aliran Susu Terputus di Tengah Jalan</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Aliran nutrisi terhenti sehingga bulir bagian pangkal malai tidak kebagian pati dan menjadi gabah melompong hampa.</p>
        </div>

        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">3. Serangan Jamur Blast Patah Leher</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Tangkai malai membusuk patah diguyur hujan malam, bulir gabah memutih hampa dan timbangan drop drastis saat dipanen.</p>
        </div>
      </div>
    </section>

    <!-- 3. PHYSICAL COMPARISON SECTION (Perbandingan Fisik Lapangan) -->
    <section class="bg-white px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Bedanya Nyata: <span class="hl-brush-red">Gabah Melompong Hampa</span> vs <span class="hl-brush">Bulir Kuning Bernas</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Gabah hampa memangkas hasil panen hingga 20%. Tapi dengan pengawalan nutrisi daun bendera, bulir padi terisi padat sampai pangkal:
      </p>

      <div class="grid grid-cols-2 gap-3.5">
        <!-- Card Bad (Kondisi Hampa) -->
        <div class="relative overflow-hidden bg-slate-50/60 rounded-lg border border-slate-100 shadow-sm">
          <img
            src="/images/landing/juara-gabah-bernas/kondisi-hampa.webp"
            alt="Kondisi bulir gabah melompong hampa putih di pangkal malai"
            class="aspect-[3/2] w-full object-cover"
            width="480"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm">
            Tanpa Pengisi Malai
          </div>
          <div class="p-3">
            <h3 class="text-[13px] font-bold text-slate-900">Gabah Melompong Hampa</h3>
            <p class="text-[11.5px] text-slate-500 mt-0.5 leading-relaxed">
              Pangkal malai kopong keputihan, timbangan anjlok drastis.
            </p>
          </div>
        </div>

        <!-- Card Good (Hasil Saratoga) -->
        <div class="relative overflow-hidden bg-slate-50/60 rounded-lg border border-slate-100 shadow-sm">
          <img
            src="/images/landing/juara-gabah-bernas/kondisi-bernas.webp"
            alt="Kondisi malai padi bernas kuning padat berisi sampai pangkal"
            class="aspect-[3/2] w-full object-cover"
            width="480"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm">
            Pakai SARATOGA
          </div>
          <div class="p-3">
            <h3 class="text-[13px] font-bold text-emerald-800">Bulir Kuning Bernas</h3>
            <p class="text-[11.5px] text-slate-600 mt-0.5 leading-relaxed">
              Padat berisi sampai pangkal leher, malai merunduk berat.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT SPECIFICATION & KNOWLEDGE (Solusi Produk SARATOGA Serum Padi) -->
    <section class="bg-white px-5 py-10">
      <!-- Fullwidth Product Banner -->
      <div class="-mx-5 mb-8">
        <img
          src="/images/landing/juara-gabah-bernas/saratoga-hero.webp"
          alt="Botol Serum Tanaman SARATOGA di Hamparan Sawah Padi Kuning Emas"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
      </div>

      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        SARATOGA — Serum Padi <span class="hl-brush">Pemadat Bulir Bernas</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        SARATOGA mengandung formula Japanese Pro-Plant Complex™ 47.5% dan kalium terionisasi yang memompa translokasi karbohidrat langsung ke dalam rongga gabah hingga bulir terbawah di pangkal malai. Menjaga daun bendera tetap segar hijau tegak sampai hari panen raya.
      </p>

      <div class="mt-8 space-y-5">
        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Gabah Padat Berisi Sampai Pangkal Malai</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Tidak ada lagi bulir gabah pangkal yang putih kopong melompong, semua padat terisi susu matang sempurna.
          </p>
        </div>

        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Gabah Hampa Kopong Ditekan di Bawah 3%</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Tingkat kematangan seragam sempurna dari ujung sampai pangkal leher tangkai malai.
          </p>
        </div>

        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Timbangan Melonjak 15-25% Lebih Berbobot</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Ubinan panen tembus rekor 8.9 - 9 Ton/Ha dengan rendemen giling beras utuh super tinggi.
          </p>
        </div>
      </div>

      <!-- Macro Shoot Explosion Photo Banner (Fullwidth Edge-to-Edge) -->
      <div class="-mx-5 mt-8 relative">
        <img
          src="/images/landing/juara-gabah-bernas/daun-bendera.webp"
          alt="Foto makro daun bendera padi hijau tegak 45 derajat mengawal malai"
          class="aspect-[16/9] w-full object-cover"
          width="1200"
          height="896"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900/90 py-2.5 px-4 text-center">
          <p class="text-[12px] font-bold text-[#BBF7D0]">
            Daun Bendera Tegak Hijau: Mengawal pengisian susu gabah sampai bulir kuning mengkilap.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. HOW IT WORKS / CARA APLIKASI LAHAN -->
    <section class="bg-emerald-50/20 px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Sederhana & <span class="hl-brush">Cepat Dipraktekkan</span> di Sawah
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Cukup 2 kali aplikasi di fase krusial pengisian malai padi:
      </p>

      <!-- Fullwidth Photo: Petani Aplikasi Semprot di Kebun -->
      <div class="-mx-5 mb-8 mt-2">
        <img
          src="/images/landing/juara-gabah-bernas/semprot-padi.webp"
          alt="Petani menyemprot kabut serum pemadat bulir di sawah padi"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Vertical Timeline Cards -->
      <div class="relative border-l-2 border-emerald-100/80 pl-7 space-y-4 ml-2 mt-6">
        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            1
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Takaran Tepat</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Campurkan 2-3 tutup botol (25-30 ml) SARATOGA per tangki 16L air bersih.
          </p>
        </div>

        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            2
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Semprot Fase Bunting & Malai Keluar</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Semprot kabut saat padi bunting tua (malai keluar 5%) dan saat pengisian bulir susu (umur 70-75 HST).
          </p>
        </div>

        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            3
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Pengisian Bulir Maksimal</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Daun bendera tetap tegak 45° hijau segar mengawal aliran susu hingga malai merunduk penuh kuning emas sampai panen raya.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. TESTIMONIALS SECTION (Hasil Nyata di Sawah Petani) -->
    <section class="bg-white px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Kisah Nyata Petani: <span class="hl-brush">Rekor Tonase Gabah Bernas</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-8">
        Lebih dari 1.700 petani padi sawah membuktikan sendiri lonjakan tonase panennya:
      </p>

      <div class="space-y-8">
        <!-- Testimoni 1: Pak Wardoyo -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Wardoyo (50 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Tani Mulyo, Desa Bentak, Kec. Sidoharjo, Kab. Sragen</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Padi Inpari 32 • Ubinan Tembus 8.9 Ton/Ha</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/juara-gabah-bernas/testi-wardoyo.webp"
              alt="Dokumentasi panen padi Pak Wardoyo ubinan 8.9 ton di Sragen"
              class="h-full w-full object-cover"
              width="1376"
              height="768"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Padi Inpari 32 seluas 1 Ha aplikasi SARATOGA saat malai keluar dan pengisian bulir. <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">Daun bendera tetap hijau tegak sampai panen, bulir gabah montok bernas sampai pangkal</strong>. Ubinan tembus 8.9 ton gabah bersih per hektar, tengkulak bayar harga tertinggi!"
          </p>

          <div class="pt-4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
        </div>

        <!-- Testimoni 2: Pak H. Dedi Junaedi -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak H. Dedi Junaedi (54 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Padasuka, Desa Rawagempol Kulon, Kec. Cilamaya Wetan, Kab. Karawang</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Padi Ciherang • Gabah Hampa Turun di Bawah 3%</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/juara-gabah-bernas/testi-dedi.webp"
              alt="Dokumentasi malai padi bernas Pak H. Dedi Junaedi di Karawang"
              class="h-full w-full object-cover"
              width="1376"
              height="768"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Padi Ciherang biasanya pangkal malai banyak yang putih kopong. Setelah disemprot SARATOGA, <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">gabah hampa turun drastis di bawah 3%, timbangan karung naik rata-rata 18 kg per kuintal</strong> saat ditimbang."
          </p>

          <div class="pt-4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
        </div>

        <!-- Testimoni 3: Pak Andi Mappatunru -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Andi Mappatunru (47 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Mattiro Deceng, Desa Mappesangka, Kec. Ponre, Kab. Bone, Sulsel</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Padi Mekongga • Bebas Blast Patah Leher</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/juara-gabah-bernas/testi-andi.webp"
              alt="Dokumentasi panen padi Pak Andi Mappatunru di Bone Sulsel"
              class="h-full w-full object-cover"
              width="1376"
              height="768"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Padi Mekongga malai terisi penuh sampai pangkal leher. <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">Bebas jamur blast potong leher disapu hujan malam</strong>, gabah kuning mengkilap dan beras giling tidak patah."
          </p>
        </div>
      </div>

      <!-- Panorama Hamparan Kebun Pulih (Fullwidth Edge-to-Edge) -->
      <div class="-mx-5 mt-10 relative">
        <img
          src="/images/landing/juara-gabah-bernas/hamparan-sawah.webp"
          alt="Foto panorama hamparan sawah padi menguning keemasan siap panen"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900/90 py-2.5 px-4 text-center">
          <p class="text-[12px] font-bold text-[#BBF7D0]">
            Hamparan Sawah Kuning Emas: Malai padi merunduk berat tanda gabah padat berisi.
          </p>
        </div>
      </div>

      <!-- Inset Card Bukti Panen Rekor -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-100 bg-slate-50/50 shadow-sm">
        <img
          src="/images/landing/juara-gabah-bernas/panen-9ton.webp"
          alt="Foto panen raya padi ubinan 9 ton per hektar gabah bernas"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
        <div class="p-3 text-center">
          <p class="text-[13px] font-semibold text-slate-800">
            Hasil Akhir: Rekor panen ubinan 8.9 ton/Ha, bulir padat mentes dan rendemen giling tinggi.
          </p>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-12">
      <div class="px-5 pb-6 text-center">
        <h2 class="mx-auto max-w-[340px] text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Pemadat Gabah</span>
        </h2>
        <p class="mx-auto mt-2 max-w-[340px] text-[14px] text-slate-600">
          Isi alamat pengiriman di bawah untuk menerima paket langsung di rumah.
        </p>
      </div>

      <GeoIpResolvedForm productSlug={product.slug} mode="hybrid" embedded={true} />
    </section>
  </main>

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
