---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import StoreSettings from '../../../components/admin/StoreSettings';

export const prerender = false;
---

<AdminLayout title="Store & Customer Service" activeMenu="settings">
  <div class="space-y-6">
    <AdminPageHeader
      eyebrow="Merchant identity"
      title="Store & customer service"
      description="Informasi merchant dan kontak yang dipakai dalam komunikasi pelanggan."
      backHref="/admin/settings"
      backLabel="Pengaturan"
    />
    <StoreSettings client:load />
  </div>
</AdminLayout>
