---
/**
 * Native Landing Page: Booster Pemanis Semangka Melon Anti Pecah: Saratoga (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/booster-manis-brix-anti-pecah.css';

export const prerender = false;

const SLUG = 'booster-manis-brix-anti-pecah';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/booster-manis-brix-anti-pecah/hero-problem.webp';
---

<BaseLayout
  title={`Booster Pemanis Semangka Melon Anti Pecah: Saratoga - ${Astro.locals.tenant.name}`}
  description="Dongkrak kadar manis Brix, warna daging merah masir semangka, dan net tebal melon. Saratoga lenturkan kulit buah agar tahan pecah saat diguyur hujan deras."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">LOLOS UJI BELAH SAMPEL BANDAR BUAH!</span>
          Semangka Pecah Hujan, Daging Pucat Hambar & Net Tipis Dijamin <span class="hl-brush">MERAH MASIR BRIX 14+</span>!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup semprot <strong class="text-slate-950 font-bold">SARATOGA</strong> di fase pembesaran buah, gula dipompa penuh ke jantung buah, daging merah masir renyah, net melon timbul 3D, kulit lentur anti-pecah!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan semangka pecah pucat hambar vs semangka merah masir manis dan melon net tebal dengan Saratoga"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Hasil Panen: Daging merah menyala sampai tepi kulit, manis lengket Brix 14+ & nol pecah buah!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Serum Kalium-Boron-Ca</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Lolos Grade A Super</span>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Kerugian Fatal <span class="hl-brush-red">Semangka & Melon Jelang Panen</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Kenapa buah yang sudah besar tiba-tiba ditolak bandar atau meledak pecah:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-manis-brix-anti-pecah/gejala-1.webp"
              alt="Buah semangka dan melon pecah merekah di lahan setelah terkena hujan"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Pecah Buah Saat Hujan (Cracking)
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Kulit Kaku Tipis Robek Merekah di Lahan</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Lonjakan air hujan mendadak mendorong daging buah mengembang cepat sementara kulit yang miskin Kalsium-Boron langsung pecah.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-manis-brix-anti-pecah/gejala-2.webp"
              alt="Belahan semangka pucat putih berongga hambar dan melon tanpa jaring net"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Daging Pucat Berongga & Net Tipis
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Tengah Buah Kopong Putih & Rasanya Hambar</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Gula tertahan di daun sehingga daging semangka pucat berair dan jaring net melon gundul tidak timbul.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON (Full Visual Overclaim) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Pecah & Pucat</span> Jadi <span class="hl-brush">Merah Masir Manis</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/booster-manis-brix-anti-pecah/overclaim-timeline.webp"
          alt="Tahapan pembesaran buah semangka dan melon dari pentil hingga net tebal dan merah manis dengan Saratoga"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">32 HST: Kulit Lentur</span>
          <span class="text-amber-300">45 HST: Net 3D Tebal</span>
          <span class="text-emerald-400">Panen: Merah Brix 14+</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/booster-manis-brix-anti-pecah/kondisi-rusak.webp"
            alt="Panen semangka dan melon tanpa Saratoga banyak pecah retak dan daging pucat"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Pecah & Hambar</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Kulit retak kena hujan, dalam berongga pucat, harga jatuh.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/booster-manis-brix-anti-pecah/kondisi-pulih.webp"
            alt="Panen semangka merah masir dan melon berjaring net tebal Grade A dengan Saratoga"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Merah Masir & Net 3D</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Daging padat manis renyah, kulit ulet tahan kirim jauh.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/booster-manis-brix-anti-pecah/saratoga-hero.webp"
          alt="Botol resmi Saratoga Serum Tanaman Premium berhologram asli untuk pemanis buah"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi SARATOGA Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">SARATOGA Original, Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Serum Kalium Bebas Klor + Kalsium-Boron Pengunci Kulit (250ml, 500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Pemanis & Pengunci SARATOGA</span> pada Buah
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Memindahkan seluruh gula daun ke dalam buah sekaligus menganyam kulit luar:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-manis-brix-anti-pecah/overclaim-1.webp"
              alt="Belahan semangka non-biji dengan daging merah tua masir padat tanpa rongga"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • MERAH MASIR & BRIX 14+
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Begitu Dibelah Bunyi 'Krak' Merah Menyala & Manis Legit!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Kalium murni bebas klor dan Boron memacu akumulasi sukrosa serta likopen dari jantung buah sampai ke batas kulit.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-manis-brix-anti-pecah/overclaim-2.webp"
              alt="Kulit buah melon dengan ukiran jaring net 3D tebal rapat dan kulit semangka lentur"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • KULIT LENTUR & NET 3D
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Anti-Pecah Diguyur Hujan & Net Melon Timbul Rapat!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Ikatan Kalsium-Boron melenturkan dinding sel epidermis kulit buah dan mengukir jaring net melon yang tebal merata.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-manis-brix-anti-pecah/overclaim-3.webp"
              alt="Buah semangka jumbo 10 kg dan melon padat di atas timbangan digital kebun"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • BOBOT PADAT TANPA RONGGA
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Hapus Hati Kosong, Berat Per Butir Naik 20%!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Pengisian sel daging buah yang rapat membuat ukuran buah seragam, padat berbobot di timbangan, dan tahan simpan.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/booster-manis-brix-anti-pecah/macro-proof.webp"
          alt="Detail makro irisan daging semangka merah kristal dan melon oranye tebal manis"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Jaminan Harga Tebasan Tertinggi: Disukai bandar besar semangka, melon, pepaya & jeruk!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis</span>
      </h2>

      <div class="-mx-5 my-4">
        <img
          src="/images/landing/booster-manis-brix-anti-pecah/aplikasi-kebun.webp"
          alt="Petani semangka dan melon menyemprotkan Saratoga pada fase pembesaran buah"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 items-stretch gap-2.5 text-center">
        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">1</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Takaran</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Umur 28–35 HST: <strong>25 ml SARATOGA</strong>/tangki 16L (lenturkan kulit).
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">2</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Aplikasi</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Umur 40–48 HST: <strong>35 ml/tangki</strong> tiap 5 hari (net & bobot).
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">3</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Interval</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            H-10 Panen: <strong>40 ml/tangki</strong> untuk mengunci manis Brix.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS & OVERCLAIM HARVEST GALLERY -->
    <section class="bg-slate-50/60 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Bukti Lapangan: <span class="hl-brush">Nol Pecah & Manis Brix Tinggi</span>
      </h2>

      <div class="mt-5 space-y-5">
        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/booster-manis-brix-anti-pecah/testi-1.webp"
            alt="Pak H. Riyanto di Lampung Timur memegang belahan semangka non-biji merah masir"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak H. Riyanto, Lampung Timur</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Nol Pecah Saat Hujan</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Umur 52 HST diguyur hujan deras 2 malam tapi semangka aman tidak pecah. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Dibelah merah masir rata-rata 8–11 kg per butir!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/booster-manis-brix-anti-pecah/testi-2.webp"
            alt="Pak Wahyu Nugroho di Ngawi menunjukkan dua buah melon dengan ukiran net tebal"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Wahyu Nugroho, Ngawi, Jatim</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Brix Melon Tembus 15</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Net melon keluar tebal timbul sampai tangkai dan <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">dites refraktometer manisnya tembus Brix 15!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/booster-manis-brix-anti-pecah/testi-3.webp"
            alt="Pak Imam Safi'i di Banyuwangi di samping pikap penuh muatan semangka Grade A"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Imam Safi'i, Banyuwangi, Jatim</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">92% Masuk Grade A</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Daging padat tanpa rongga, <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">timbangan satu truk naik hampir 2 ton dibanding musim lalu!</strong>"
            </p>
          </div>
        </div>
      </div>

      <!-- Fullwidth Overclaim Panorama -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/booster-manis-brix-anti-pecah/hamparan-kebun.webp"
          alt="Hamparan kebun semangka dan melon saat panen raya dengan buah jumbo berjajar rapi"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-950 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Panen Kelas Supermarket: Warna merah pekat, manis seragam, dan tahan angkut antarpulau!
          </p>
        </div>
      </div>

      <!-- 2-Card Final Overclaim Showcase -->
      <div class="mt-5 grid grid-cols-2 items-stretch gap-3">
        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/booster-manis-brix-anti-pecah/panen-rekor.webp"
            alt="Tumpukan panen semangka jumbo dan melon net tebal siap muat ke truk pasar induk"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Rebutan Penebas</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">Lolos uji belah sampel pertama</p>
          </div>
        </div>

        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/booster-manis-brix-anti-pecah/panen-2.webp"
            alt="Buah melon berjaring net 3D rapat dan semangka mengilap hasil aplikasi Saratoga"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Tahan Kirim Jauh</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">Kulit ulet tidak pecah di truk</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-12">
      <div class="px-5 pb-6 text-center">
        <span class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-[11px] font-bold text-emerald-900">
          Garansi Produk Asli {product.productName}
        </span>
        <h2 class="mx-auto mt-2 max-w-[340px] text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Booster Manis Buah</span>
        </h2>
        <p class="mx-auto mt-2 max-w-[340px] text-[14px] text-slate-600">
          Pilih ukuran kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}) di bawah. Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        mode="hybrid"
        embedded={true}
      />
    </section>
  </main>

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
