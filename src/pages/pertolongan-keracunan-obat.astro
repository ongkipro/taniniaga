---
/**
 * Native Landing Page: LP-03 Pertolongan Keracunan Obat & Overdosis Pestisida (BENSU)
 *
 * Visual Pattern: Inspired by AdsBook Direct Response Architecture
 * Master Product: bensu-pupuk-cair-organik
 * Kontrak Arsitektur: docs/LANDING-PAGES.md & docs/spec/10-BRUTAL-OVERCLAIM-LANDING-PAGES-CATALOG.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import FormHybridContent from '../components/storefront/forms/FormHybridContent.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/pertolongan-keracunan-obat.css';

export const prerender = false;

const SLUG = 'pertolongan-keracunan-obat';

const product = await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik');
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/pertolongan-keracunan-obat/hero-problem.webp';
---

<BaseLayout
  title={`Solusi Daun Gosong & Keracunan Obat Tanaman: Pulih dalam 4 Hari | ${Astro.locals.tenant.name}`}
  description="Pertolongan pertama daun cabai melepuh gosong akibat overdosis pestisida dan salah campur obat kimia. Netralkan racun dan picu tunas baru tanpa bongkar bedengan."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={false}
>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector=""
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <!-- 1. HERO SECTION (High-Impact Mobile First-Fold / Stop Scrolling Hook) -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-8">
        <h1 class="mx-auto max-w-[440px] text-[clamp(28px,7.8vw,34px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight">JANGAN DICABUT DULU!</span>
          Daun Gosong & Melepuh Kena Racun Kimia Dijamin <span class="hl-brush">PULIH & BERTUNAS</span> dalam 4 Hari
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[15.5px] font-medium leading-relaxed text-slate-700">
          Cuci semprot 1 kali <strong class="text-slate-950 font-bold">BENSU</strong>, racun kimia ternetralkan dan tunas cadangan langsung mekar tanpa bongkar bedengan!
        </p>
      </div>

      <div class="mt-6">
        <!-- Hero Image: Fullwidth Edge-to-Edge with Proof Banner Overlay -->
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi tanaman cabai daun melepuh gosong akibat overdosis racun kimia berhasil pulih dan bertunas lebat sehabis disemprot BENSU"
            class="h-full w-full object-cover"
            width="1200"
            height="896"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/80 px-4 py-2.5 text-center backdrop-blur-sm">
            <p class="text-[12.5px] font-bold text-[#BBF7D0]">
              Racun kimia dinetralkan, daun gosong terhenti dan tunas muda baru mekar dalam 4 hari!
            </p>
          </div>
        </div>

        <!-- Trust Points Row -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 px-4 text-[12px] font-semibold text-slate-700">
          <span>100% Organik Dingin</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Garansi Pulih 4 Hari</span>
        </div>

        <!-- Takeaway Box with left accent border -->
        <div class="mt-5 mx-5 text-left border-l-2 border-emerald-600 pl-4 bg-emerald-50/40 py-2.5 pr-3 rounded-r">
          <p class="text-[14.5px] font-bold text-slate-950">Tanaman keracunan obat jangan buru-buru dibongkar atau disemprot pupuk kimia keras lagi.</p>
          <p class="text-[13px] leading-relaxed text-slate-600 mt-1">
            Sel daun sedang melepuh dan klorofil hancur. Cuci kabut dengan formula asam amino dingin untuk mendetoksifikasi racun kimia seketika agar kebun puluhan juta terselamatkan.
          </p>
        </div>
      </div>
    </section>

    <!-- 2. HARD PROBLEM SECTION (Fakta Lapangan Tanaman Keracunan Obat) -->
    <section class="bg-red-50/30 px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Kenapa Daun Tanaman Bisa <span class="hl-brush-red">Gosong & Melepuh</span> Sehabis Disemprot?
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Niatnya membasmi hama atau jamur, tapi sedikit saja salah takaran atau disemprot saat matahari terik, efeknya bisa membunuh tanaman:
      </p>

      <div class="space-y-4">
        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">1. Salah Campur Obat & Cuaca Panas Terik</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Mencampur insektisida, fungisida pekat, dan perekat saat siang terik membakar kutikula pelindung daun hingga hangus kecokelatan.</p>
        </div>

        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">2. Klorofil Hancur & Stomata Rusak</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Residu racun kimia menyerap ke jaringan sel dan meracuni kloroplas. Daun keriting kaku melepuh, berhenti bernapas, dan fotosintesis anjlok total.</p>
        </div>

        <div>
          <h3 class="text-[15.5px] font-bold text-slate-900">3. Panik Malah Ngebom Pupuk NPK</h3>
          <p class="text-[14px] text-slate-600 mt-0.5 leading-relaxed">Petani panik mengira tanaman kurang makan lalu mengocor pupuk kimia pekat. Akibatnya sel tanaman yang sedang luka bakar makin hangus dan mati total!</p>
        </div>
      </div>
    </section>

    <!-- 3. PHYSICAL COMPARISON SECTION (Perbandingan Fisik Lapangan) -->
    <section class="bg-white px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Bedanya Nyata: <span class="hl-brush-red">Gosong Melepuh</span> vs <span class="hl-brush">Tunas Pulih Segar</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Kebun keracunan obat yang dibiarkan akan mengering mati dan terpaksa dibongkar. Tapi dengan pencucian nutrisi dingin, racun dinetralkan dan tunas baru mekar rimbun:
      </p>

      <div class="grid grid-cols-2 gap-3.5">
        <!-- Card Bad (Kondisi Gosong) -->
        <div class="relative overflow-hidden bg-slate-50/60 rounded-lg border border-slate-100 shadow-sm">
          <img
            src="/images/landing/pertolongan-keracunan-obat/kondisi-gosong.webp"
            alt="Kondisi daun tanaman cabai keriting gosong melepuh karena overdosis racun kimia"
            class="aspect-[3/2] w-full object-cover"
            width="480"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm">
            Kondisi Gosong
          </div>
          <div class="p-3">
            <h3 class="text-[13px] font-bold text-slate-900">Daun Melepuh Keriting</h3>
            <p class="text-[11.5px] text-slate-500 mt-0.5 leading-relaxed">
              Klorofil terbakar, pucuk mengering kaku, modal bedengan puluhan juta terancam hangus.
            </p>
          </div>
        </div>

        <!-- Card Good (Hasil Pulih) -->
        <div class="relative overflow-hidden bg-slate-50/60 rounded-lg border border-slate-100 shadow-sm">
          <img
            src="/images/landing/pertolongan-keracunan-obat/kondisi-pulih.webp"
            alt="Kondisi tanaman cabai bertunas lebat baru sehabis cuci semprot Bensu"
            class="aspect-[3/2] w-full object-cover"
            width="480"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm">
            Hasil 4 Hari
          </div>
          <div class="p-3">
            <h3 class="text-[13px] font-bold text-emerald-800">Tunas Cadangan Mekar</h3>
            <p class="text-[11.5px] text-slate-600 mt-0.5 leading-relaxed">
              3 tunas baru pecah di tiap ketiak daun, hijau segar sehat dan siap jadi ranting produktif.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT SPECIFICATION & KNOWLEDGE (Solusi Produk BENSU Detoksifikasi) -->
    <section class="bg-white px-5 py-10">
      <!-- Fullwidth Product Banner -->
      <div class="-mx-5 mb-8">
        <img
          src="/images/landing/pertolongan-keracunan-obat/bensu-hero.webp"
          alt="Botol Pupuk Organik Cair BENSU di Kebun Hortikultura Subur"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
      </div>

      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        BENSU — Formula Dingin <span class="hl-brush">Detoksifikasi Racun</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        BENSU mengandung asam amino bebas L-isomer murni berenergi tinggi yang bertindak sebagai penetral fitotoksisitas pestisida pada tanaman. Meresap ke dalam jaringan sel untuk mendetoksifikasi sisa racun kimia, menghentikan penjalaran luka gosong, dan merangsang pembelahan tunas cadangan.
      </p>

      <div class="mt-8 space-y-5">
        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Menetralkan Residu Racun Kimia</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Asam amino bebas mengikat dan mendetoksifikasi racun kimia pada cairan sel daun dalam tempo 24 jam pertama.
          </p>
        </div>

        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Menghentikan Kerusakan Menjalar</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Mengisolasi jaringan daun yang terbakar agar luka tidak merambat ke titik tumbuh pucuk dan meristem cadangan.
          </p>
        </div>

        <div class="border-l-2 border-emerald-600 pl-4 py-1">
          <h3 class="text-[15.5px] font-bold text-slate-900">Mengganti Daun Rusak dengan 3 Tunas Baru</h3>
          <p class="text-[14px] text-slate-600 mt-1 leading-relaxed">
            Memicu keluarnya ranting baru yang jauh lebih produktif dan rimbun, menggantikan daun yang sempat gosong terbakar.
          </p>
        </div>
      </div>

      <!-- Macro Shoot Explosion Photo Banner (Fullwidth Edge-to-Edge) -->
      <div class="-mx-5 mt-8 relative">
        <img
          src="/images/landing/pertolongan-keracunan-obat/tunas-regenerasi.webp"
          alt="Foto makro tunas baru mekar segar dari ketiak cabang tanaman yang sempat keracunan racun kimia"
          class="aspect-[16/9] w-full object-cover"
          width="1200"
          height="896"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900/90 py-2.5 px-4 text-center">
          <p class="text-[12px] font-bold text-[#BBF7D0]">
            Hasil 4 Hari: Tunas baru segar langsung bermunculan di ketiak cabang, kebun kembali produktif.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. HOW IT WORKS / CARA APLIKASI LAHAN -->
    <section class="bg-emerald-50/20 px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Langkah Darurat: <span class="hl-brush">Cara Cuci Semprot</span> Lahan
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-6">
        Jangan tunggu daun mengering habis. Lakukan pertolongan pertama sore ini juga:
      </p>

      <!-- Fullwidth Photo: Petani Aplikasi Semprot di Kebun -->
      <div class="-mx-5 mb-8 mt-2">
        <img
          src="/images/landing/pertolongan-keracunan-obat/cuci-semprot.webp"
          alt="Petani melakukan cuci semprot kabut nutrisi dingin di lahan tanaman cabai yang sempat overdosis racun kimia"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Vertical Timeline Cards -->
      <div class="relative border-l-2 border-emerald-100/80 pl-7 space-y-4 ml-2 mt-6">
        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            1
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Takaran Cuci Daun</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Campurkan 3-4 tutup botol BENSU (35 ml) ke dalam 1 tangki semprot (16 liter air bersih) tanpa dicampur obat atau racun lain.
          </p>
        </div>

        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            2
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Semprot Kabut Basah Merata</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Semprotkan kabut halus ke daun atas dan bawah saat pagi teduh atau sore hari pukul 15.30 ke atas agar nutrisi meresap maksimal.
          </p>
        </div>

        <div class="relative bg-white p-4 rounded-xl border border-slate-100 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <span class="absolute -left-[41px] top-4 flex h-7 w-7 items-center justify-center rounded-full bg-[#14532D] text-white text-[12px] font-bold ring-4 ring-white shadow-sm shadow-emerald-200">
            3
          </span>
          <h3 class="text-[15px] font-bold text-slate-900">Ulangi Selang 3 Hari</h3>
          <p class="text-[13.5px] text-slate-600 mt-1.5 leading-relaxed">
            Cukup 2 kali aplikasi, daun berhenti rontok gosong dan ketiak cabang langsung ramai tunas segar hijau royo-royo.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. TESTIMONIALS SECTION (Hasil Nyata di Kebun Petani) -->
    <section class="bg-white px-5 py-10">
      <h2 class="text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
        Kisah Nyata Petani: <span class="hl-brush">Kebun Rusak Terselamatkan</span>
      </h2>
      <p class="text-[15px] leading-relaxed text-slate-600 mt-3 mb-8">
        Bukti nyata petani yang berhasil menyelamatkan kebunnya tanpa perlu keluar biaya bongkar bedengan puluhan juta:
      </p>

      <div class="space-y-8">
        <!-- Testimoni 1: Pak Sutrisno -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Sutrisno (41 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Karya Tani, Desa Sukorejo, Gurah, Kediri</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Cabai Rawit Kaliber • Daun Melepuh Kena Overdosis Racun</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/pertolongan-keracunan-obat/testi-sutrisno.webp"
              alt="Dokumentasi tanaman cabai rawit Pak Sutrisno pulih setelah cuci semprot Bensu di Kediri"
              class="h-full w-full object-cover"
              width="1376"
              height="768"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Cabai rawit Kaliber 4.000 pohon salah takar racun ulat campur perekat di cuaca terik siang. Besok paginya <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 text-slate-950 font-semibold">daun melepuh gosong keriting kayak disiram air mendidih</strong>. Langsung saya cuci semprot BENSU dosis 35 ml per tangki sore itu juga. Hari ke-5 <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">keluar tunas baru segar semua</strong>, kebun selamat tanpa perlu bongkar bedengan!"
          </p>

          <div class="pt-4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
        </div>

        <!-- Testimoni 2: Pak H. Rohidin -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak H. Rohidin (52 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Mitra Tani, Desa Cikandang, Cikajang, Garut</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Kentang Granola & Cabai • Overdosis Fungisida Tembaga</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/pertolongan-keracunan-obat/testi-rohidin.webp"
              alt="Dokumentasi kebun kentang dan cabai Pak H. Rohidin kembali hijau dan bertunas rimbun di Garut"
              class="h-full w-full object-cover"
              width="1376"
              height="768"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Tanaman sempat overdosis fungisida tembaga hingga daun terbakar kecokelatan. <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 text-slate-950 font-semibold">Sempat panik mau babat bedengan</strong>. Disemprot kabut BENSU 2 kali selang 3 hari, <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">daun kembali hijau segar dan pucuk baru mekar sempurna</strong>."
          </p>

          <div class="pt-4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
        </div>

        <!-- Testimoni 3: Pak Basuki -->
        <div class="space-y-3">
          <div>
            <h3 class="text-[16px] font-bold text-slate-900">Pak Basuki (48 th)</h3>
            <p class="text-[12px] text-slate-500 mt-0.5">Poktan Argo Lestari, Desa Kejajar, Wonosobo</p>
            <p class="text-[12px] font-semibold text-emerald-800 mt-1">Cabai Rawit • Kena Drift Herbisida Pematang Tetangga</p>
          </div>

          <div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-100">
            <img
              src="/images/landing/pertolongan-keracunan-obat/testi-basuki.webp"
              alt="Dokumentasi tanaman cabai Pak Basuki pulih dari drift herbisida di Wonosobo"
              class="h-full w-full object-cover"
              width="1376"
              height="768"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="border-l-2 border-emerald-600/30 pl-3 text-[14.5px] leading-relaxed text-slate-700 italic">
            "Cabai rawit kena kabut herbisida dari pematang tetangga. Daun langsung kuning lemas. <strong class="box-decoration-clone bg-emerald-100 px-1.5 pb-0.5 text-emerald-800 font-semibold">Setelah disemprot dan kocor BENSU, klorofil daun pulih normal dan tunas baru mekar rimbun</strong>."
          </p>
        </div>
      </div>

      <!-- Panorama Hamparan Kebun Pulih (Fullwidth Edge-to-Edge) -->
      <div class="-mx-5 mt-10 relative">
        <img
          src="/images/landing/pertolongan-keracunan-obat/kebun-selamat.webp"
          alt="Foto panorama hamparan kebun cabai terselamatkan dan rimbun hijau subur di perbukitan"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900/90 py-2.5 px-4 text-center">
          <p class="text-[12px] font-bold text-[#BBF7D0]">
            Kebun Selamat: Modal puluhan juta tidak hangus, tanaman cabai kembali sehat dan siap panen raya.
          </p>
        </div>
      </div>

      <!-- Inset Card Bukti Panen Rekor -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-100 bg-slate-50/50 shadow-sm">
        <img
          src="/images/landing/pertolongan-keracunan-obat/panen-jumbo.webp"
          alt="Foto pohon cabai pulih berbuah lebat berbobot sampai panen"
          class="aspect-[16/9] w-full object-cover"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
        <div class="p-3 text-center">
          <p class="text-[13px] font-semibold text-slate-800">
            Hasil Akhir: Tanaman pulih total, berbuah lebat berbobot sampai musim panen selesai.
          </p>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-12">
      <div class="px-5 pb-6 text-center">
        <h2 class="mx-auto max-w-[340px] text-[clamp(26px,7.2vw,30px)] font-extrabold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Detoksifikasi</span>
        </h2>
        <p class="mx-auto mt-2 max-w-[340px] text-[14px] text-slate-600">
          Isi alamat pengiriman di bawah untuk menerima paket langsung di rumah.
        </p>
      </div>

      <FormHybridContent productSlug={product.slug} embedded={true} />
    </section>
  </main>

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
