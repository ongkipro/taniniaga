---
/**
 * Native Landing Page: Penawar Stres Keracunan Obat Daun Gosong: Bensu (BENSU)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: bensu-pupuk-cair-organik (ID: 21329)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/pertolongan-keracunan-obat.css';

export const prerender = false;

const SLUG = 'pertolongan-keracunan-obat';

const product =
  (await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '21329'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 0;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/pertolongan-keracunan-obat/hero-problem.webp';
---

<BaseLayout
  title={`Penawar Stres Keracunan Obat Daun Gosong: Bensu - ${Astro.locals.tenant.name}`}
  description="Pulihkan tanaman gosong, daun kaku menggulung, dan pucuk macet akibat overdosis pestisida atau herbisida. Bensu buka kuncian pucuk baru dalam 24–72 jam."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-24 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">JANGAN CABUT TANAMAN OVERDOSIS OBAT!</span>
          Daun Gosong Kaku, Menggulung & Pucuk Macet Habis Semprot Obat Dijamin <span class="hl-brush">PECAH TUNAS BARU</span> 72 Jam!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup cuci semprot <strong class="text-slate-950 font-bold">BENSU</strong>, residu pestisida panas & tempias herbisida langsung dinetralkan, daun kembali lemas segar, tunas baru meletus di tiap ketiak!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan tanaman gosong kaku keracunan pestisida vs pulih keluar tunas baru dengan Bensu"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Hasil 24–72 Jam: Daun kaku kembali lentur hijau & tunas ketiak muda pecah mulus bebas kerdil!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>L-Amino Detoks Sel</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Rp4.000/Tangki</span>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Bahaya Fatal <span class="hl-brush-red">Overdosis & Salah Oplos Obat</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Ketika takaran insektisida/fungisida terlalu panas atau terkena angin herbisida:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/pertolongan-keracunan-obat/gejala-1.webp"
              alt="Daun cabai gosong cokelat di pinggir dan melengkung kaku akibat overdosis pestisida"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Daun Gosong & Kaku Sendok
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Pinggiran Daun Terbakar & Melengkung Getas</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Pelarut EC pestisida membakar lapisan lilin daun dan mengunci stomata sehingga daun melengkung kaku mudah patah.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/pertolongan-keracunan-obat/gejala-2.webp"
              alt="Pucuk tanaman cabai mengerut macet seperti bonsai dan bunga rontok karena herbisida"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Pucuk Bonsai & Bunga Rontok
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Titik Tumbuh Terkunci & Bunga Gugur Serentak</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Tanpa detoks asam amino bebas, pucuk macet berbulan-bulan seperti plastik dan seluruh bunga rontok ke mulsa.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON (Full Visual Overclaim) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Gosong Macet</span> Jadi <span class="hl-brush">Tunas Meletus</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/pertolongan-keracunan-obat/overclaim-timeline.webp"
          alt="Tahapan pemulihan tanaman dari keracunan pestisida jam ke-0 hingga hari ke-5 dengan Bensu"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Jam 0: Gosong Kaku</span>
          <span class="text-amber-300">48 Jam: Daun Lemas</span>
          <span class="text-emerald-400">Hari 5: Tunas Baru</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/pertolongan-keracunan-obat/kondisi-rusak.webp"
            alt="Tanaman tanpa Bensu tetap kerdil kaku dan daun gosong rontok"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa BENSU
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Kerdil Permanen</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Pucuk terkunci rapat, daun rontok, umur panen mundur sebulan.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/pertolongan-keracunan-obat/kondisi-pulih.webp"
            alt="Tanaman pulih dengan Bensu keluar tunas baru hijau segar dan kembali berbunga"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai BENSU
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Pulih & Berbunga</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Tunas ketiak baru tumbuh mulus lebar dan bunga kembali jadi buah.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/pertolongan-keracunan-obat/bensu-hero.webp"
          alt="Botol resmi Bensu Pupuk Cair Organik berhologram asli untuk pemulihan stres obat"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi BENSU Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">BENSU Original, Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            L-Amino Acid Bebas + Fulvic Chelate Detoks + Bio-Stimulan Sel (500ml & 1L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Penawar Racun BENSU</span> pada Tanaman Stres
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Menyelamatkan sel stomata yang terbakar tanpa menguras sisa energi tanaman:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/pertolongan-keracunan-obat/overclaim-1.webp"
              alt="Daun cabai kembali lentur hijau segar berembun setelah disemprot Bensu"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • DETOKS STOMATA 24 JAM
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Cuci Residu Kimia & Lemaskan Daun Kaku!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Asam Fulvat mengikat residu bahan aktif pestisida dan logam berat di jaringan daun sehingga stomata kembali bernapas normal.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/pertolongan-keracunan-obat/overclaim-2.webp"
              alt="Tunas ketiak baru dan bakal bunga segar pecah serempak dari ruas batang cabai"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • PECAH TUNAS 3–5 HARI
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Buka Kuncian Pucuk Bonsai dari Setiap Ketiak Daun!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Asam amino L-bebas memicu pembelahan sel meristem baru untuk menggantikan pucuk lama yang telanjur gosong terbakar.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/pertolongan-keracunan-obat/overclaim-3.webp"
              alt="Tanaman cabai yang pulih dari keracunan obat berbuah lebat kembali"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • SELAMATKAN BUNGA & BUAH
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Batal Cabut Tanaman, Jadwal Panen Tetap Aman!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Menekan hormon stres etilen pemicu rontok bunga sehingga tanaman kembali produktif berbuah lebat sesuai umur.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/pertolongan-keracunan-obat/macro-proof.webp"
          alt="Detail makro tunas hijau muda baru yang keluar dari ketiak daun yang sempat terbakar"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            P3K Wajib Kebun: Semakin cepat disemprot setelah kejadian, semakin cepat tunas baru mekar!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis</span>
      </h2>

      <div class="-mx-5 my-4">
        <img
          src="/images/landing/pertolongan-keracunan-obat/aplikasi-kebun.webp"
          alt="Petani menyemprotkan kabut halus Bensu pada pagi hari untuk mencuci residu obat"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 items-stretch gap-2.5 text-center">
        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">1</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Takaran</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Stop pestisida kimia 5 hari. Larutkan <strong>35 ml BENSU</strong>/tangki 16L.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">2</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Aplikasi</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Semprot kabut basah merata pagi hari (<strong>tanpa oplos obat</strong>).
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">3</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Interval</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Ulangi tiap <strong>3 hari sekali</strong> (cukup 2–3 kali).
          </p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS & OVERCLAIM HARVEST GALLERY -->
    <section class="bg-slate-50/60 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Bukti Lapangan: <span class="hl-brush">Ribuan Pohon Batal Dicabut</span>
      </h2>

      <div class="mt-5 space-y-5">
        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/pertolongan-keracunan-obat/testi-1.webp"
            alt="Pak Sutrisno di Banyuwangi bersama tanaman cabai yang pulih dari overdosis obat"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Sutrisno, Banyuwangi, Jatim</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">4.000 Cabai Selamat</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Salah oplos 3 insektisida bikin 4.000 cabai melengkung kaku. Disemprot BENSU 2x, <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">hari ke-4 tunas baru keluar mulus di semua pohon!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/pertolongan-keracunan-obat/testi-2.webp"
            alt="Pak Basuki di Sragen di lahan melon yang pulih dari tempias herbisida"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Basuki, Sragen, Jateng</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Pulih dari Herbisida</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Melon 25 HST kena tempias obat rumput sampai pucuk kuning mengerut. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Dikocor & semprot BENSU, seminggu langsung jalan normal lagi!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/pertolongan-keracunan-obat/testi-3.webp"
            alt="Pak Rohidin di Brebes menunjukkan daun bawang merah yang kembali tegak hijau"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Rohidin, Brebes, Jateng</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Pucuk Gosong Berhenti</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
              "Ujung bawang merah terbakar habis semprot fungisida pekat. <strong class="bg-emerald-100 px-1 text-emerald-900 not-italic">Dicuci BENSU, daun baru tumbuh tegak hijau sampai panen!</strong>"
            </p>
          </div>
        </div>
      </div>

      <!-- Fullwidth Overclaim Panorama -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/pertolongan-keracunan-obat/hamparan-kebun.webp"
          alt="Hamparan kebun cabai dan hortikultura yang kembali hijau subur setelah pemulihan Bensu"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-950 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Selamatkan Modal Jutaan: Pulihkan tanaman cabai, tomat, bawang, melon & padi dari stres obat!
          </p>
        </div>
      </div>

      <!-- 2-Card Final Overclaim Showcase -->
      <div class="mt-5 grid grid-cols-2 items-stretch gap-3">
        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/pertolongan-keracunan-obat/panen-rekor.webp"
            alt="Hasil panen cabai merah melimpah dari kebun yang berhasil diselamatkan dengan Bensu"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Panen 100% Selamat</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">Batal tanam ulang dari nol</p>
          </div>
        </div>

        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/pertolongan-keracunan-obat/panen-2.webp"
            alt="Percabangan cabai sehat penuh buah merah dan hijau segar pasca aplikasi Bensu"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col justify-center px-3 py-2.5 text-center">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Tajuk Mulus Kembali</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">Daun lebar lentur bebas kerdil</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-12">
      <div class="px-5 pb-6 text-center">
        <span class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-[11px] font-bold text-emerald-900">
          Garansi Produk Asli {product.productName}
        </span>
        <h2 class="mx-auto mt-2 max-w-[340px] text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Penawar Stres Obat</span>
        </h2>
        <p class="mx-auto mt-2 max-w-[340px] text-[14px] text-slate-600">
          Pilih ukuran kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}) di bawah. Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        selectedVariantId={cheapest?.id}
        mode="hybrid"
        embedded={true}
      />
    </section>

    <!-- Floating Bottom CTA Bar (Auto-hides while checkout form is in view) -->
    <div
      id="lp-floating-bar"
      class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full max-w-[480px] items-center justify-between gap-3 border-t border-slate-200/90 bg-white/95 px-4 py-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom))] shadow-[0_-8px_24px_rgba(15,23,42,0.1)] backdrop-blur-md transition-all duration-300"
    >
      <div class="min-w-0">
        <p class="truncate text-[11px] font-semibold text-emerald-800">
          BENSU {cheapest?.label ?? '500ml'} • Bisa COD
        </p>
        <div class="mt-0.5 flex items-baseline gap-1.5">
          <span class="text-[18px] font-bold leading-none tracking-tight text-slate-950">
            {formatIdr(price)}
          </span>
          {
            comparePrice > price && (
              <span class="text-[12px] font-normal text-slate-400 line-through">
                {formatIdr(comparePrice)}
              </span>
            )
          }
        </div>
      </div>
      <a
        href="#checkout-form"
        class="inline-flex min-h-11 shrink-0 items-center justify-center gap-1.5 rounded-xl bg-[#15803d] px-5 text-[13px] font-bold text-white shadow-[0_4px_12px_rgba(21,128,61,0.28)] transition-colors hover:bg-[#166534] active:scale-[0.98]"
      >
        <span>Pesan Sekarang (COD)</span>
        <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </main>

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });

    function initLpFloatingBar() {
      const bar = document.getElementById('lp-floating-bar');
      const form = document.getElementById('checkout-form');
      if (!bar || !form || !('IntersectionObserver' in window)) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              bar.style.transform = 'translateY(100%)';
              bar.style.opacity = '0';
              bar.style.pointerEvents = 'none';
            } else {
              bar.style.transform = 'translateY(0)';
              bar.style.opacity = '1';
              bar.style.pointerEvents = 'auto';
            }
          });
        },
        { threshold: 0.05 }
      );
      observer.observe(form);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLpFloatingBar);
    } else {
      initLpFloatingBar();
    }
  </script>
</BaseLayout>
